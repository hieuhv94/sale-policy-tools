# Ảnh VẬN HÀNH: migration, sao lưu, phục hồi, dọn dữ liệu, mồi tài khoản (`0105`).
#
# Tới `0104` những việc này chạy bằng ảnh `postgres:16-alpine` cộng BẢY bind mount
# đọc từ cây mã nguồn (`db/migrations/`, `scripts/*.sh`). Trên máy chủ khách chỉ
# có `docker compose pull` thì không có cây mã nguồn nào — nghĩa là "chỉ pull" chỉ
# đúng với lúc CHẠY, còn sao lưu và phục hồi lại đòi mã nguồn. Đúng vào lúc cần
# nhất thì không có.
#
# DỰNG TỪ CHÍNH ẢNH SERVICE, không dựng lại từ `node:alpine`.
#
# Ảnh service đã `COPY . .` nên nó đã mang sẵn `db/migrations/` và `scripts/`, và
# đã cài xong toàn bộ phụ thuộc. Kế thừa nó nghĩa là ảnh ops dùng lại TOÀN BỘ lớp
# của ảnh service — máy chủ pull thêm ảnh này gần như không tốn gì. Dựng lại từ
# đầu thì nó là một bản sao 533MB thứ hai của cùng một thứ, và hai bản sao ấy sẽ
# lệch nhau vào ngày ai đó sửa một script mà chỉ dựng lại một bên.
ARG BASE=csbh-service:dev
FROM ${BASE}

# `postgresql16-client` cho psql · pg_dump · pg_restore · pg_isready ·
# pg_basebackup. `openssl` cho `gen-secrets.sh`.
#
# `postgresql16` (gói MÁY CHỦ) cho đúng MỘT lệnh: `pg_archivecleanup`, lượt dọn
# WAL cuối `basebackup.sh` (`0234`). Alpine xếp nó vào gói máy chủ chứ không vào
# gói client. Tới `0104` sao lưu chạy trên ảnh `postgres:16-alpine` nên có sẵn;
# `0105` chuyển sang ảnh này và chỉ cài client — từ đó MỌI lượt sao lưu chết ở
# dòng dọn WAL, SAU khi bản nền đã ghi xong, nên: WAL không bao giờ được dọn, bản
# sao ra `BACKUP_MIRROR_DIR` (bước kế tiếp) không bao giờ chạy, và `./csbh
# nang-cap` dừng ngay bước sao lưu. `tests/http/anh-ops.test.ts` đối chiếu mọi
# lệnh `pg_*` mà các script gọi với gói cài ở đây.
USER root
RUN apk add --no-cache postgresql16-client postgresql16 openssl

# Vá lỗi cùng lớp với `NODE_ENV`: các script vận hành gọi `tsx`, mà `tsx` là
# devDependency — ảnh service cài đầy đủ nên nó có sẵn.
WORKDIR /app

COPY docker/ops-entrypoint.sh /usr/local/bin/csbh-ops
RUN chmod +x /usr/local/bin/csbh-ops

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/csbh-ops"]
CMD ["help"]
