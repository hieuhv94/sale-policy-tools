#	=============================================================================
#	Caddy — biên mạng. Là container DUY NHẤT mở cổng ra ngoài (SEC-10).
#
#	Ba việc, không hơn: kết thúc TLS, phục vụ SPA tĩnh, và chuyển /api/* vào
#	gateway. Giới hạn tần suất KHÔNG nằm ở đây — xem lý do ở
#	services/gateway/src/proxy/rate-limit.ts: bộ đếm phải theo người dùng, mà
#	Caddy không đọc được JWT.
#	=============================================================================

{
	# Cổng dành cho kiểm tra sức khoẻ nội bộ, không phát ra ngoài.
	admin off
	email {$ACME_EMAIL:admin@nutricare.local}
}

# Tập header an toàn dùng chung cho mọi phản hồi (SEC-09).
(security_headers) {
	header {
		# HSTS: 2 năm, gồm cả tên miền con, và có preload. Đặt ở đây chứ không ở
		# ứng dụng vì nó phải có mặt cả trên phản hồi lỗi và trên file tĩnh.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		# Chặn trình duyệt tự đoán kiểu nội dung. Không có dòng này thì một file
		# tải lên có nội dung HTML nhưng khai là .txt vẫn chạy được script.
		X-Content-Type-Options "nosniff"

		# Chặn nhúng vào iframe của trang khác — chống clickjacking.
		X-Frame-Options "DENY"

		# Chỉ gửi origin khi sang trang khác, không gửi đường dẫn đầy đủ. Đường
		# dẫn của hệ này chứa id hồ sơ; gửi kèm là rò rỉ định danh sang bên thứ ba.
		Referrer-Policy "strict-origin-when-cross-origin"

		# Tắt hẳn ba quyền thiết bị mà ứng dụng không dùng tới.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"

		# CSP: chỉ tải tài nguyên từ chính mình. `frame-ancestors 'none'` lặp lại
		# ý của X-Frame-Options theo chuẩn mới — giữ cả hai vì trình duyệt cũ chỉ
		# hiểu cái trước.
		#
		# `style-src` phải có 'unsafe-inline': Ant Design tiêm CSS lúc chạy. Đây
		# là nới lỏng CÓ Ý THỨC và hẹp nhất có thể — script vẫn bị khoá chặt, mà
		# script mới là thứ chạy được mã.
		#
		# `frame-src blob:` và `img-src blob:` (`0072`) — BẮT BUỘC cho việc xem
		# tệp trong phần mềm, và đây là chỗ đã hỏng thật.
		#
		# Mọi lượt xem đều phải đi qua `blob:`: đường tải nội dung đòi header
		# `Authorization`, mà `<iframe src>` và `<img src>` không gửi header nào —
		# nên `XemTep` tải nội dung bằng `fetch` rồi dựng một `blob:` URL để nhúng.
		# Không khai `frame-src` thì nó rơi về `default-src 'self'`, và `blob:`
		# KHÔNG thuộc `'self'`: trình duyệt chặn, hiện đúng một dòng "This content
		# is blocked" mà không nói vì sao.
		#
		# Vì sao chuyện này lọt qua cả bộ kiểm thử: CSP là header của Caddy, còn
		# test chạy thẳng vào service và jsdom thì không thi hành CSP. Chỉ chồng
		# demo — nơi có Caddy thật và trình duyệt thật — mới lộ ra.
		#
		# `connect-src` KHÔNG có `blob:`, và đó là cố ý (`0079`, đo được).
		#
		# Nghĩa là `fetch()` hay `XMLHttpRequest` tới một `blob:` URL bị chặn.
		# Giao diện không cần: nó NHÚNG blob (`<iframe src>`, `<img src>`) và TẢI
		# blob (`<a download href>`) — cả ba đều không phải "connect". Ghi ra đây
		# vì nó tốn của tôi một lượt chẩn đoán nhầm: một phép đo đọc ngược blob
		# bằng `fetch` báo lỗi, và trông hệt như lượt tải file đang hỏng.
		#
		# `blob:` hẹp hơn hẳn `*`: nó chỉ cho phép nội dung do CHÍNH trang này tạo
		# ra trong bộ nhớ tab, không mở cửa cho một nguồn ngoài nào. `object-src`
		# vẫn `'none'` — `<object>` và `<embed>` không có việc gì ở đây.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Không tiết lộ máy chủ nào đang chạy.
		-Server
	}
}

{$SITE_ADDRESS:localhost} {
	import security_headers

	# API vào gateway. `handle_path` cắt bỏ tiền tố /api trước khi chuyển tiếp,
	# nên bảng định tuyến trong gateway viết theo đường dẫn thật của service
	# (/policies, /auth…) chứ không phải /api/policies.
	handle_path /api/* {
		reverse_proxy gateway:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# SPA: mọi đường dẫn không phải file tĩnh đều trả index.html để React Router
	# tự định tuyến. Thiếu dòng này thì tải lại trang ở /policies/abc ra 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd

	log {
		output stdout
		format json
	}
}
