# Lịch vận hành Chính sách bán hàng (`0105`).
#
# Cài:  sudo cp cron.mau /etc/cron.d/csbh && sudo chmod 644 /etc/cron.d/csbh
# Sửa `/opt/csbh` thành đường dẫn thật của bộ cài, và `csbh` thành tài khoản
# chạy docker trên máy chủ.
#
# VÌ SAO PHẢI CÓ TỆP NÀY. Lịch sao lưu (giờ chạy, tần suất, số bản giữ) do Quản
# trị đặt trên trang Vận hành và nằm trong CSDL (`0251`), nhưng thứ ĐÁNH THỨC việc
# sao lưu vẫn là cron: mỗi 15 phút nó hỏi `./csbh … --neu-den-han`, và lệnh ấy chỉ
# chạy khi đã tới giờ. Không cài tệp này thì không lượt sao lưu tự động nào xảy ra —
# cam kết "mất tối đa một chu kỳ sao lưu" thành không có thật (xem RPO-RTO.md).
#
# Dọn dữ liệu hết hạn KHÔNG còn ở đây: `sla-worker` tự chạy theo giờ đã cấu hình.

# KẾT QUẢ GHI RA LOG, không gửi thư. Cron gửi thư khi lệnh in ra bất cứ thứ gì,
# và một lệnh sao lưu chạy đúng vẫn in ra vài dòng — nên hộp thư quản trị sẽ
# ngập, rồi người ta lọc chúng đi, rồi lượt hỏng thật cũng bị lọc theo.
# Cách đúng: đọc log, và theo dõi tuổi của tệp sao lưu mới nhất.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Sao lưu CSDL và kho tệp THEO LỊCH ĐÃ CẤU HÌNH — hỏi mỗi 15 phút, chạy khi tới
# giờ. Hai lệnh dùng chung một khoá tệp nên không bao giờ chạy chồng nhau.
*/15 * * * *   csbh  cd /opt/csbh && ./csbh sao-luu --neu-den-han     >> /var/log/csbh-sao-luu.log 2>&1
*/15 * * * *   csbh  cd /opt/csbh && ./csbh sao-luu-tep --neu-den-han >> /var/log/csbh-sao-luu.log 2>&1

# DIỄN TẬP phục hồi hằng tháng, ngày 8, 03:30 — vào CSDL nháp, không đụng dữ
# liệu thật. RTO 60 phút là con số ĐO ĐƯỢC; không diễn tập thì nó thành ước lượng.
30 3 8 * *   csbh  cd /opt/csbh && ./csbh dien-tap    >> /var/log/csbh-dien-tap.log 2>&1
