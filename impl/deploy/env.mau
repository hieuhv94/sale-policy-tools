# =============================================================================
# TỆP CẤU HÌNH DUY NHẤT của hệ Chính sách bán hàng — /etc/csbh/csbh.env (`0270`).
#
# `sudo ./cai-dat.sh` đọc tệp này và làm mọi việc còn lại: cài Docker, dựng thư mục,
# sinh mật khẩu nội bộ, kéo ảnh, kiểm thử, dựng hệ, tạo tài khoản Quản trị đầu tiên,
# cài lịch tự động. Sửa tệp này rồi chạy lại `sudo ./cai-dat.sh` là áp cấu hình mới —
# KHÔNG đụng dữ liệu.
#
# Dòng ghi `THAY_…` là BẮT BUỘC phải điền; còn sót một dòng thì bộ cài dừng và nói
# tên dòng ấy. Dòng ghi "tuỳ chọn" để trống được.
#
# TỆP NÀY CHỨA MẬT KHẨU. Bộ cài đặt quyền 640 root:csbh — đừng chép nó đi đâu.
# Mật khẩu ở đây KHÔNG vào container qua biến môi trường (`docker inspect` sẽ in
# chúng ra): `csbh` ghi chúng thành tệp trong <workspace>/secrets/ và container đọc tệp.
# =============================================================================

# --- Thư mục làm việc (WORKSPACE) --------------------------------------------
#
# Nơi chứa MỌI THỨ của riêng máy này: dữ liệu (CSDL, tệp đã tải lên), bản sao lưu,
# bí mật, log. Chương trình nằm riêng ở /opt/csbh và thay ở mỗi lần cập nhật;
# workspace thì sống qua mọi lần cập nhật.
#
# Đường TUYỆT ĐỐI. Nên đặt trên ổ dữ liệu của VPS nếu có (vd. /data/csbh). Đổi giá trị
# này SAU KHI đã cài thì bộ cài dừng và hướng dẫn cách dời — nó không tự dời dữ liệu.
CSBH_WORKSPACE=/srv/csbh

# --- Tên chồng ---------------------------------------------------------------
#
# Tên dự án compose — quyết định tên volume dữ liệu (`0106`). Phải KHÁC `csbh` (tên
# chồng demo/bộ kiểm dùng). Trên máy chủ chỉ có một chồng; giữ nguyên.
COMPOSE_PROJECT_NAME=csbh-prod

# --- Ảnh Docker --------------------------------------------------------------
#
# Kho ảnh trên registry. Máy chạy thẻ `-latest`; cập nhật bằng `sudo csbh cap-nhat`.
CSBH_IMAGE=__IMAGE__
# Tài khoản đọc registry. Với Docker Hub: tên tài khoản và một Access Token quyền
# "Read-only" (Account Settings → Personal access tokens) — KHÔNG dùng mật khẩu.
REGISTRY_USER=THAY_TEN_TAI_KHOAN_REGISTRY
REGISTRY_TOKEN=THAY_TOKEN_DOC_REGISTRY

# --- Địa chỉ -----------------------------------------------------------------
#
# Tên miền, KHÔNG kèm https://. DNS phải trỏ về IP máy này TRƯỚC khi cài: Caddy tự
# xin chứng chỉ HTTPS ngay lúc dựng, và Let's Encrypt khoá theo tuần nếu thử hỏng
# nhiều lần. Bộ cài kiểm điều này (bỏ kiểm: --bo-kiem-dns, khi đứng sau proxy).
SITE_ADDRESS=THAY_TEN_MIEN
# Tuỳ chọn. Bỏ trống là https://<SITE_ADDRESS> — địa chỉ nằm trong LIÊN KẾT mọi email.
SITE_URL=
# Thư nhận cảnh báo hết hạn chứng chỉ từ Let's Encrypt.
ACME_EMAIL=THAY_EMAIL_QUAN_TRI

# --- Thư ---------------------------------------------------------------------
#
# Máy chủ SMTP thật. KHÔNG được là localhost/mailpit — hệ thống từ chối khởi động.
MAIL_HOST=THAY_MAY_CHU_SMTP
MAIL_PORT=587
# Địa chỉ ở ô "From". Tên miền này phải có SPF · DKIM · DMARC, nếu không thư mời rơi
# vào spam — và triệu chứng giống hệt "hệ thống hỏng".
MAIL_FROM=THAY_DIA_CHI_GUI_THU
# TÊN MIỀN ĐƯỢC PHÉP NHẬN THƯ — ngăn bằng dấu phẩy, miền con tự được chấp nhận
# (`nutricare.vn` nhận cả `tdv@hn.nutricare.vn`). Chặn việc một địa chỉ cá nhân gõ
# nhầm nhận toàn bộ thông báo nghiệp vụ.
MAIL_ALLOWLIST=THAY_TEN_MIEN_NHAN_THU
# Xác thực SMTP. Bỏ trống CẢ HAI nếu relay nội bộ không đòi xác thực.
MAIL_USER=
MAIL_PASSWORD=
# TLS. Để trống là mặc định an toàn: STARTTLS BẬT SẴN với mọi máy chủ thật.
#   MAIL_SECURE=1        TLS ngay từ đầu kết nối (cổng 465)
#   MAIL_STARTTLS=false  Tắt STARTTLS — chỉ cho relay nội bộ không hỗ trợ TLS
MAIL_SECURE=
MAIL_STARTTLS=

# --- Tài khoản Quản trị đầu tiên ---------------------------------------------
#
# Bộ cài tạo tài khoản này ở LẦN CÀI ĐẦU (CSDL chưa có tài khoản nào), rồi XOÁ TRẮNG
# dòng mật khẩu bên dưới. Lần đăng nhập đầu tiên bắt buộc đổi mật khẩu. Các lần chạy
# sau bộ cài bỏ qua mục này.
#
# Email phải thuộc MAIL_ALLOWLIST. Mật khẩu tối thiểu 10 ký tự, có chữ và số.
ADMIN_TEN_DANG_NHAP=admin
ADMIN_EMAIL=THAY_EMAIL_QUAN_TRI
ADMIN_HO_TEN=Quản trị hệ thống
ADMIN_MAT_KHAU=THAY_MAT_KHAU_TAM

# --- Đường lưu trữ (tuỳ chọn) ------------------------------------------------
#
# Tương đối thì tính theo CSBH_WORKSPACE. BẢN SAO RA ĐĨA KHÁC: nên trỏ sang một ổ
# KHÁC ổ chứa workspace — bản sao lưu cùng đĩa với dữ liệu gốc thì hỏng đĩa là mất cả hai.
CSBH_BACKUP_MIRROR=backup-mirror
CSBH_LOG_ARCHIVE=logarchive
CSBH_LOG_DIR=logs

# --- Đăng nhập bằng Google (tuỳ chọn, `0241`) --------------------------------
#
# Bỏ trống GOOGLE_CLIENT_ID là TẮT. Tạo OAuth Client loại "Web application" ở Google
# Cloud Console, khai Authorized redirect URI = <SITE_URL>/api/auth/google/callback.
# Chỉ tài khoản Google có email TRÙNG một tài khoản đã cấp mới vào được.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Miền Google Workspace của công ty — tài khoản ngoài miền này bị từ chối.
GOOGLE_HOSTED_DOMAIN=
