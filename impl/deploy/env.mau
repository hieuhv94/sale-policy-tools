# =============================================================================
# Bản khai môi trường của MỘT lần cài đặt.
#
# Chép thành `.env` cạnh tệp này rồi điền. Mọi dòng dưới đây đều BẮT BUỘC trừ
# những dòng ghi rõ "tuỳ chọn" — thiếu một dòng bắt buộc thì `docker compose`
# dừng ngay và nói tên biến, chứ không dựng lên rồi hỏng ở giữa.
#
# TỆP NÀY CHỨA MẬT KHẨU. `chmod 600 .env`, và không chép nó đi đâu.
# =============================================================================

# --- Tên chồng ---------------------------------------------------------------
#
# TÊN DỰ ÁN COMPOSE, và nó quyết định tên các volume dữ liệu (`0106`).
#
# Phải KHÁC tên mà chồng demo và bộ test dùng (`csbh`). Chung tên nghĩa là chung
# volume `pgdata`, mà mật khẩu Postgres chỉ được đặt LÚC KHỞI TẠO LẦN ĐẦU: một
# volume đã dựng bởi bản demo vẫn giữ mật khẩu của bản demo, còn chồng production
# thì trình ra mật khẩu vừa sinh trong `secrets/`. Triệu chứng:
#
#   error: password authentication failed for user "postgres"
#
# — một câu không nhắc gì tới volume dùng chung.
#
# Trên máy chủ khách hàng chỉ có một chồng nên tên nào cũng được; giữ nguyên.
COMPOSE_PROJECT_NAME=csbh-prod

# --- Ảnh ---------------------------------------------------------------------
# Repo chứa cả ba ảnh. Chúng phân biệt bằng thẻ: `service-…`, `web-…`, `ops-…`.
CSBH_IMAGE=__IMAGE__
# Phiên bản. KHÔNG đổi thành `latest`: xem chú thích đầu compose.prod.yml.
CSBH_TAG=__TAG__

# --- Địa chỉ -----------------------------------------------------------------
# Tên miền thật. Caddy tự xin và tự gia hạn chứng chỉ theo giá trị này, nên DNS
# phải trỏ về máy chủ TRƯỚC khi dựng lần đầu.
SITE_ADDRESS=csbh.nutricare.vn
# Cùng tên miền, kèm giao thức. Đây là địa chỉ nằm trong LIÊN KẾT của mọi email.
SITE_URL=https://csbh.nutricare.vn
# Địa chỉ Let's Encrypt gửi cảnh báo hết hạn chứng chỉ.
ACME_EMAIL=it@nutricare.vn

# --- Thư ---------------------------------------------------------------------
# Máy chủ SMTP của công ty. KHÔNG được là mailpit/localhost — production trỏ vào
# hộp thư giả thì hệ thống từ chối khởi động.
MAIL_HOST=smtp.nutricare.vn
MAIL_PORT=587
# Địa chỉ người nhận nhìn thấy ở ô "From". Tên miền này phải có SPF · DKIM ·
# DMARC, nếu không thư mời rơi vào spam — và triệu chứng giống hệt "hệ thống hỏng".
MAIL_FROM=csbh-noreply@nutricare.vn

# TÊN MIỀN ĐƯỢC PHÉP NHẬN THƯ — bắt buộc, và nhận NHIỀU miền.
#
# Ngăn bằng dấu phẩy. Miền con tự động được chấp nhận: khai `nutricare.vn` là
# `tdv@hn.nutricare.vn` cũng nhận được thư.
#
# Đây là thứ chặn một địa chỉ cá nhân gõ nhầm vào hồ sơ tài khoản rồi nhận toàn
# bộ thông báo nghiệp vụ — công nợ, giá thu về, tên khách hàng.
MAIL_ALLOWLIST=nutricare.vn

# Xác thực SMTP. Bỏ trống cả hai nếu relay nội bộ không đòi xác thực.
MAIL_USER=
# Mật khẩu để trong FILE, không để thẳng ở đây: giá trị trong `.env` hiện ra ở
# `docker inspect` của mọi container dùng nó.
MAIL_PASSWORD_FILE=/run/secrets/mail_password.txt

# TLS. Để trống là dùng mặc định an toàn: STARTTLS BẬT SẴN với mọi máy chủ thật.
#   MAIL_SECURE=1       TLS ngay từ đầu kết nối (cổng 465)
#   MAIL_STARTTLS=false Tắt STARTTLS — chỉ dùng cho relay nội bộ không hỗ trợ TLS
MAIL_SECURE=
MAIL_STARTTLS=

# --- Bí mật ------------------------------------------------------------------
# KHÔNG có mật khẩu nào trong tệp này (`0106`).
#
# Postgres và MinIO đọc thẳng từ `secrets/pg_password.txt` và
# `secrets/minio_password.txt`, do `cai-dat.sh` sinh ra trên chính máy chủ này.
# Chép mật khẩu sang đây nữa là dựng ra hai bản của cùng một bí mật, và chúng sẽ
# lệch nhau vào ngày ai đó đổi một bên.

# --- Đường lưu trữ (tuỳ chọn) ------------------------------------------------
# Nơi để bản sao lưu và kho log. Mặc định nằm cạnh bộ cài; đổi sang một ĐĨA KHÁC
# nếu có — bản sao lưu nằm cùng đĩa với dữ liệu gốc thì hỏng đĩa là mất cả hai.
# Đường dẫn tính theo thư mục `deploy/`, nên `../` là gốc bộ cài.
CSBH_BACKUP_MIRROR=../backup-mirror
CSBH_LOG_ARCHIVE=../logarchive

# --- Đăng nhập bằng Google (`0241`) --------------------------------------------
# Bỏ trống GOOGLE_CLIENT_ID là TẮT: màn hình đăng nhập không bày nút Google.
# Tạo OAuth Client loại "Web application" ở Google Cloud Console, khai
#   Authorized redirect URI = <SITE_URL>/api/auth/google/callback
# rồi chép client secret vào secrets/google_client_secret.txt.
# Chỉ tài khoản Google có email TRÙNG một tài khoản đã cấp mới vào được.
GOOGLE_CLIENT_ID=
# Miền Google Workspace của công ty — tài khoản ngoài miền này bị từ chối.
GOOGLE_HOSTED_DOMAIN=nutricare.vn
GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret.txt
