#!/bin/sh
# Lệnh vận hành hằng ngày trên MÁY CHỦ KHÁCH HÀNG (`0105`).
#
# Trên máy phát triển những việc này là `make ...`. Máy chủ khách không có
# Makefile, không có mã nguồn, và người vận hành ở đó không nhất thiết biết
# docker compose — nên đây là lớp mỏng bọc lại, với đúng những việc họ cần và
# đúng những câu cảnh báo đi kèm.
#
# BA CHỖ của một bản cài (`0270`), mỗi chỗ một vai:
#
#   chương trình  thư mục chứa CHÍNH tệp này và `deploy/` — `/opt/csbh/current/`
#                 trên máy khách, thay ở mỗi lượt cập nhật; `csbh` KHÔNG ghi gì vào đây;
#   cấu hình      MỘT tệp `/etc/csbh/csbh.env` (đè được bằng `CSBH_ENV=<tệp>` — chỉ bộ
#                 kiểm và người gỡ lỗi dùng);
#   workspace     `CSBH_WORKSPACE` khai trong tệp cấu hình (mặc định `/srv/csbh`):
#                 bí mật, dữ liệu, sao lưu, log, trạng thái chạy. `csbh` chạy TRONG nó.
#
# Tới `0269` cả ba là một thư mục (bộ cài), nên mọi đường dẫn viết tương đối. Tách ra
# để thay chương trình không bao giờ cuốn theo `.env`, `secrets/` hay dữ liệu.
set -eu

CT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ENV_TEP="${CSBH_ENV:-/etc/csbh/csbh.env}"

# Giá trị của một khoá trong tệp cấu hình (dòng cuối thắng, như compose đọc).
doc_env() { grep -E "^$1=" "$ENV_TEP" 2>/dev/null | tail -1 | cut -d= -f2- || true; }

# `nhap-chuyen-may` là lệnh DUY NHẤT chạy khi CHƯA có tệp cấu hình (`0246`): nó chạy
# trên một bộ cài vừa giải nén, và chính nó mang cấu hình của máy cũ tới.
if [ "${1:-}" != "nhap-chuyen-may" ]; then
  [ -f "$ENV_TEP" ] || { echo "Không thấy $ENV_TEP. Cài đặt bằng: sudo ./cai-dat.sh" >&2; exit 1; }
  [ -r "$ENV_TEP" ] || { echo "Không đọc được $ENV_TEP — chạy bằng tài khoản csbh hoặc sudo." >&2; exit 1; }

  # Tên dự án compose quyết định tên volume dữ liệu. Thiếu nó thì compose lấy tên
  # thư mục, và trên một máy đã từng chạy bản demo thì tên ấy có thể trùng — chung
  # volume `pgdata` nghĩa là mật khẩu Postgres của bản demo thắng, và mọi lệnh
  # chạm CSDL hỏng với "password authentication failed". Xem `csbh.env.mau`.
  grep -qE '^COMPOSE_PROJECT_NAME=.' "$ENV_TEP" || {
    echo "Thiếu COMPOSE_PROJECT_NAME trong $ENV_TEP. Thêm dòng: COMPOSE_PROJECT_NAME=csbh-prod" >&2
    exit 1
  }
fi

# Đặt các đường của workspace thành ĐƯỜNG TUYỆT ĐỐI rồi XUẤT ra môi trường: compose
# nội suy `${CSBH_WORKSPACE}`… từ đây (biến môi trường thắng `--env-file`), nên
# `csbh.env` được phép ghi tương đối theo workspace. `dat_workspace` gọi lại được —
# `nhap-chuyen-may` gọi nó sau khi đã mang tệp cấu hình của máy cũ tới.
dat_workspace() {
  WS="$(doc_env CSBH_WORKSPACE)"; WS="${WS:-/srv/csbh}"
  case "$WS" in /?*) ;; *) echo "CSBH_WORKSPACE phải là một đường tuyệt đối (đang là: '$WS')." >&2; exit 1 ;; esac
  duong_ws() { v="$(doc_env "$1")"; [ -n "$v" ] || v="$2"; case "$v" in /*) echo "$v" ;; *) echo "$WS/$v" ;; esac; }
  CSBH_WORKSPACE="$WS"
  CSBH_LOG_DIR="$(duong_ws CSBH_LOG_DIR logs)"
  CSBH_LOG_ARCHIVE="$(duong_ws CSBH_LOG_ARCHIVE logarchive)"
  CSBH_BACKUP_MIRROR="$(duong_ws CSBH_BACKUP_MIRROR backup-mirror)"
  # Hai bí mật do NGƯỜI DÙNG khai trong `csbh.env` (xem `dong_bo_bi_mat`): có giá trị
  # thì service đọc tệp dẫn xuất, rỗng thì biến `_FILE` rỗng — service hiểu là tắt.
  MAIL_PASSWORD_FILE=""; [ -n "$(doc_env MAIL_PASSWORD)" ] && MAIL_PASSWORD_FILE=/run/secrets/mail_password.txt
  GOOGLE_CLIENT_SECRET_FILE=""; [ -n "$(doc_env GOOGLE_CLIENT_SECRET)" ] && GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret.txt
  # `SITE_URL` bỏ trống là `https://<SITE_ADDRESS>` — bớt một chỗ khai trùng (`0270`).
  SITE_URL="$(doc_env SITE_URL)"; [ -n "$SITE_URL" ] || SITE_URL="https://$(doc_env SITE_ADDRESS)"
  export CSBH_WORKSPACE CSBH_LOG_DIR CSBH_LOG_ARCHIVE CSBH_BACKUP_MIRROR MAIL_PASSWORD_FILE GOOGLE_CLIENT_SECRET_FILE SITE_URL
  RUN="$WS/run"
  DC="docker compose --env-file $ENV_TEP -f $CT/deploy/compose.yml -f $CT/deploy/compose.prod.yml"
  # Dữ liệu sống bind vào workspace — CHỈ chồng thật (xem đầu tệp ấy).
  [ -f "$CT/deploy/compose.du-lieu.yml" ] && DC="$DC -f $CT/deploy/compose.du-lieu.yml"
  # Đường hầm thử nghiệm: địa chỉ tạm nằm ở `run/thu-nghiem`, KHÔNG ghi vào tệp cấu
  # hình (`csbh` không có quyền ghi `/etc/csbh/`). Xuất ra môi trường là đè được.
  if [ -f "$RUN/thu-nghiem" ]; then
    DC="$DC -f $CT/deploy/compose.tunnel.yml"
    while IFS= read -r dong; do
      case "$dong" in SITE_ADDRESS=*|SITE_URL=*) export "${dong?}" ;; esac
    done < "$RUN/thu-nghiem"
  fi
}

if [ "${1:-}" != "nhap-chuyen-may" ]; then
  dat_workspace
  [ -d "$WS" ] || { echo "Workspace $WS chưa có. Cài đặt bằng: sudo ./cai-dat.sh" >&2; exit 1; }
  mkdir -p "$RUN" "$WS/tmp" 2>/dev/null || true
  cd "$WS"
fi

# Dẫn xuất hai bí mật NGƯỜI DÙNG khai trong `csbh.env` ra `secrets/` (`0270`).
#
# Container không bao giờ thấy giá trị thật qua biến môi trường (`0106` — `docker
# inspect` in mọi biến): compose KHÔNG nhắc tới `MAIL_PASSWORD`/`GOOGLE_CLIENT_SECRET`,
# nên chúng không vào container; container đọc tệp dẫn xuất. `csbh.env` là NGUỒN —
# tệp ở `secrets/` ghi lại ở mỗi lượt `len`/`cap-nhat`, nên hai chỗ không lệch nhau
# được lâu hơn một lượt chạy. Giá trị rỗng → xoá tệp.
dong_bo_bi_mat() {
  for cap in MAIL_PASSWORD:mail_password.txt GOOGLE_CLIENT_SECRET:google_client_secret.txt; do
    k=${cap%%:*}; t="$WS/secrets/${cap#*:}"; v="$(doc_env "$k")"
    if [ -n "$v" ]; then
      ( umask 077; printf '%s' "$v" > "$t.tam" ) && mv "$t.tam" "$t"
    else
      rm -f "$t"
    fi
  done
}

usage() {
  cat <<'HET'
csbh — vận hành Chính sách bán hàng

  Chạy hệ thống
    len              Dựng hệ. KHÔNG kéo ảnh khi máy đã có — chỉ kéo khi thiếu.
    xuong            Dừng toàn hệ. Dữ liệu giữ nguyên.
    trang-thai       Service nào đang sống, healthcheck ra sao.
    log [service]    Xem log, mặc định 200 dòng cuối của tất cả.
    phien-ban        Phiên bản đang chạy (đọc từ chính ảnh).

  Cập nhật
    cap-nhat         Hỏi registry có bản `latest` mới không; có thì sao lưu, kéo,
                     migration, dựng lại. GIỮ NGUYÊN dữ liệu.
    lui-lai          Về lại ảnh trước lượt cap-nhat gần nhất (khi chưa có migration mới).
    upgrade          Lên bản MỚI NHẤT trên registry cho bản CHẠY THỬ, và XOÁ
                     SẠCH dữ liệu: CSDL dựng lại từ trống, kho tệp dọn sạch.
                     Sau đó phải làm lại mo-tai-khoan và nap-danh-muc. KHÔNG
                     đụng đường hầm, nên địa chỉ công khai giữ nguyên.

  Dữ liệu
    sao-luu          Sao lưu CSDL, giữ tối đa N bản theo lịch đã cấu hình. Cron hỏi
                     mỗi 15 phút (--neu-den-han); gõ tay là chạy ngay.
    dien-tap         DIỄN TẬP phục hồi vào CSDL nháp. KHÔNG đụng dữ liệu thật.
    phuc-hoi <tệp>   Phục hồi ĐÈ lên dữ liệu đang chạy. Hỏi lại trước khi làm.
    don-du-lieu      Dọn dữ liệu hết hạn ngay. sla-worker tự chạy hằng ngày theo giờ
                     đã cấu hình — lệnh này chỉ để chạy tay.
    sao-luu-tep      Chụp KHO TỆP (bản scan, bản mềm, giấy tờ, mẫu) thành một bản
                     theo mốc, ở bản sao lưu và bản sao ngoài; giữ tối đa
                     GIU_TOI_DA_TEP bản (mặc định 7). Tệp không đổi không tốn thêm chỗ.
    phuc-hoi-tep [mốc]
                     Chép kho tệp từ một bản chụp (mặc định mới nhất) trở lại.
                     Hỏi lại trước khi làm.

  Chuyển sang máy khác
    xuat-chuyen-may  Trên máy CŨ: dừng hệ, xuất CSDL + kho tệp + nhật ký đã trích
                     thành một gói, và bí mật thành một gói RIÊNG có mật khẩu.
    nhap-chuyen-may <gói dữ liệu> <gói bí mật>
                     Trên máy MỚI, trong bộ cài CÙNG phiên bản vừa giải nén (chưa
                     chạy cai-dat.sh): nạp lại tất cả, ĐỐI CHIẾU với máy cũ, rồi
                     mới bật phần mềm.

  Cài đặt ban đầu
    mo-tai-khoan     Tạo tài khoản Quản trị ĐẦU TIÊN. Chỉ chạy được một lần.
    thu-thu          Gửi một lá thư thử tới địa chỉ truyền vào.
    nap-danh-muc     Nạp DỮ LIỆU MẪU: sản phẩm, giá, 3 quy định chiết khấu,
                     3 văn bản mẫu. Chỉ chạy được khi danh mục còn trống.

  Chạy thử qua Internet (KHÔNG dùng cho bàn giao thật)
    mo-thu-nghiem    Mở đường hầm Cloudflare, in ra địa chỉ công khai.
    dong-thu-nghiem  Đóng đường hầm, trả cấu hình về như cũ.

  Tác tử vận hành (systemd chạy, không gõ tay)
    tac-tu           Vòng lặp nhận việc từ trang Vận hành ("Sao lưu ngay"), báo trạng
                     thái container, thu log hạ tầng, đo cỡ volume. --mot-nhip: một nhịp.

  psql [...]         Mở psql vào CSDL.
HET
}

ops() { $DC run --rm -T ops "$@"; }

# --- Việc theo lịch (`0251`) ---------------------------------------------------
#
# Lịch (giờ chạy, tần suất, số bản giữ) nằm ở `ops.cau_hinh_viec`, Quản trị đặt trên
# trang Vận hành. Cron gọi `./csbh sao-luu --neu-den-han` mỗi 15 phút; câu hỏi "đến hạn
# chưa" trả lời bằng `ops.den_han` — MỘT hàm cho cron, `sla-worker` và trang web.
#
# Mỗi lượt (theo lịch hay gõ tay) ghi một dòng `ops.lan_chay`: trang Vận hành đọc nó
# cho "lần gần nhất", `den_han` đọc nó cho "đã chạy cho mốc này chưa".
#
# CSDL KHÔNG TRẢ LỜI thì vẫn sao lưu theo lịch MẶC ĐỊNH — bỏ lượt là cách tệ nhất để
# phản ứng với một CSDL đang trục trặc. Lịch mặc định nằm ở lời gọi (`chay_theo_lich
# … 0115 …`), cùng con số migration `0124` nạp vào bảng.

# Một câu SQL qua ảnh ops. Hỏng thì in rỗng — người gọi tự quyết làm gì.
q_ops() { $DC run --rm -T ops psql -v ON_ERROR_STOP=1 -qtA -c "$1" 2>/dev/null || true; }

# "co <giu>" · "khong <giu>" · rỗng khi không đọc được.
doc_lich() {
  q_ops "SELECT CASE WHEN ops.den_han('$1', now()) THEN 'co' ELSE 'khong' END || ' ' || coalesce(giu_toi_da::text, '-')
           FROM ops.cau_hinh_viec WHERE viec = '$1'"
}

# Phút trong ngày (giờ VN) của một chuỗi HHMM. `expr` chứ không `$(( ))`: "08" trong
# `$(( ))` là số BÁT PHÂN hỏng.
phut_cua() { expr "$(echo "$1" | cut -c1-2)" \* 60 + "$(echo "$1" | cut -c3-4)"; }

# chay_theo_lich VIEC GIU_MAC_DINH GIO_MAC_DINH(HHMM) [--neu-den-han] HAM
chay_theo_lich() {
  viec=$1; giu=$2; gio_md=$3; co_lich=0; ham=$5
  case "${4:-}" in
    --neu-den-han) co_lich=1 ;;
    '') ;;
    *) echo "  Không hiểu '$4'. Dùng: ./csbh $( [ "$viec" = SAO_LUU_CSDL ] && echo sao-luu || echo sao-luu-tep ) [--neu-den-han]" >&2; return 2 ;;
  esac

  # Hai việc sao lưu không chạy chồng nhau: cùng đọc/ghi thư mục sao lưu, cùng tranh
  # đĩa. Khoá tệp tự nhả khi tiến trình chết — không có khoá mồ côi.
  if command -v flock > /dev/null 2>&1; then
    exec 9> "$RUN/khoa-sao-luu"
    # Theo lịch: bỏ qua, thoát 0 (cron không có gì phải báo). Gõ tay / tác tử: mã 75 —
    # người bấm "Sao lưu ngay" phải thấy lượt của mình KHÔNG chạy, không phải "xong" (`0254`).
    flock -n 9 || {
      echo "==> $viec: một lượt sao lưu khác đang chạy — bỏ qua lượt này"
      [ "$co_lich" = 1 ] && return 0
      return 75
    }
  fi

  lich="$(doc_lich "$viec")"
  if [ -n "$lich" ]; then
    den="${lich%% *}"; g="${lich#* }"
    [ "$g" = "-" ] || giu="$g"
  else
    echo "  CẢNH BÁO — không đọc được lịch từ CSDL; dùng mặc định: giữ $giu bản, chạy lúc $gio_md." >&2
    den=khong
    bay_gio="$(phut_cua "${CSBH_GIO_VN:-$(TZ=Asia/Ho_Chi_Minh date +%H%M)}")"   # CSBH_GIO_VN: chỉ bộ kiểm đặt
    moc="$(phut_cua "$gio_md")"
    [ "$bay_gio" -ge "$moc" ] && [ "$bay_gio" -lt "$((moc + 15))" ] && den=co
  fi
  [ "$co_lich" = 1 ] && [ "$den" != co ] && return 0

  tu_dong=false; [ "$co_lich" = 1 ] && tu_dong=true
  # Lượt do Quản trị bấm trên web mang người bấm (`0254`). Chỉ nhận đúng dạng uuid — giá
  # trị này đi thẳng vào câu SQL.
  cot="viec, tu_dong"; gt="'$viec', $tu_dong"
  case "${CSBH_NGUOI_CHAY:-}" in
    *[!0-9a-f-]*|'') ;;
    ????????-????-????-????-????????????) cot="$cot, nguoi_chay"; gt="$gt, '$CSBH_NGUOI_CHAY'" ;;
  esac
  id="$(q_ops "INSERT INTO ops.lan_chay ($cot) VALUES ($gt) RETURNING id")"
  ra="$(mktemp)"
  # KHÔNG `if "$ham" …; then`: trong điều kiện của `if`, `set -e` bị TẮT cho cả thân
  # hàm, nên một lượt chụp hỏng giữa chừng mà bước kiểm cuối vẫn chạy được sẽ ghi
  # THÀNH CÔNG. Subshell bật lại `set -e`, ngoài mọi ngữ cảnh điều kiện.
  set +e
  ( set -e; "$ham" "$giu" ) > "$ra" 2>&1
  ma=$?
  set -e
  if [ "$ma" = 0 ]; then ket=THANH_CONG; else ket=LOI; fi
  cat "$ra"
  if [ -n "$id" ]; then
    # Đầu ra có thể mang dấu nháy — dollar-quoting thay vì tự thoát ký tự.
    q_ops "UPDATE ops.lan_chay SET ket_thuc = now(), ket_qua = '$ket',
             chi_tiet = \$csbh_ra\$$(tail -n 40 "$ra")\$csbh_ra\$ WHERE id = $id" > /dev/null
  fi
  rm -f "$ra"
  return $ma
}

sao_luu_csdl() { $DC run --rm -T -e GIU_TOI_DA="$1" ops backup; }

# `0250` — BẢN CHỤP theo mốc, giữ tối đa N bản chụp.
sao_luu_kho_tep() {
  giu="$1"
  luu="$(doc_env COMPOSE_PROJECT_NAME)_pgbackup"
  moc="${CSBH_MOC:-$(date -u +%Y%m%dT%H%M%SZ)}"
  echo "==> chụp kho tệp vào bản sao lưu ($moc, giữ tối đa $giu bản)"
  mc_sh "GOC=/backup/kho-tep CU=/backup/tep GIU=$giu MOC=$moc; $CHUP_KHO_TEP" -v "${luu}:/backup"
  guong="$CSBH_BACKUP_MIRROR"
  if [ -d "$guong" ]; then
    echo "==> chụp sang bản sao ngoài: $guong"
    mc_sh "GOC=/mirror/kho-tep CU=/mirror/tep GIU=$giu MOC=$moc; $CHUP_KHO_TEP" -v "${guong}:/mirror"
  else
    echo "  KHÔNG có thư mục bản sao ngoài ($guong) — kho tệp chỉ nằm trên máy này." >&2
  fi
  echo "==> kiểm: mọi tệp CSDL trỏ tới đã có trong bản chụp vừa tạo"
  ops chuyen-may ban-ke "/backup/kho-tep/$moc"
}

# --- Kho tệp và chuyển máy (`0246`) ------------------------------------------

NGUOI="$(id -u):$(id -g)"

# Một đoạn lệnh `mc` trong container MinIO dựng riêng cho lượt này.
#
# `mc` chứ không thư viện `minio` của Node: thư viện ấy treo khi liệt kê kho lớn
# ("Entity expansion limit exceeded", xem đoạn dọn kho của `upgrade`). Container
# riêng (`run`, không `exec`) để gắn được thư mục tạm bằng `-v` mà KHÔNG phải sửa
# `compose.prod.yml` — bản cài đang chạy dùng được lệnh này mà không chép tệp
# compose mới. Ảnh MinIO chỉ có `mc`, `sha256sum`, `sort` (đo 05/11): mọi phép
# băm và so sánh nằm ở `scripts/chuyen-may.sh`, trong ảnh `ops`.
#
# Mật khẩu đọc TỪ FILE BÍ MẬT trước: chồng production đặt `MINIO_ROOT_PASSWORD`
# rỗng có chủ ý (`0108`).
mc_sh() {
  lenh="$1"; shift
  $DC run --rm -T --no-deps -e MC_CONFIG_DIR=/tmp/.mc "$@" --entrypoint sh minio -c '
    mk="$(cat "${MINIO_ROOT_PASSWORD_FILE:-/run/secrets/minio_password.txt}" 2>/dev/null || true)"
    [ -n "$mk" ] || mk="${MINIO_ROOT_PASSWORD:-}"
    mc alias set l http://minio:9000 "$MINIO_ROOT_USER" "$mk" > /dev/null || exit 1
    '"$lenh"
}

# Một BẢN CHỤP kho tệp, chạy TRONG container MinIO (`0250`). Đầu vào là biến shell
# GOC (thư mục chứa các bản chụp), CU (bố cục trước `0250`), GIU, MOC.
#
#   <GOC>/<MOC>/tep/<bucket>/<khoá>   ← nội dung
#   <GOC>/<MOC>/csdl.txt …            ← bảng kê của CHÍNH bản chụp này (`ban-ke`)
#
# Bản mới khởi đầu bằng LIÊN KẾT CỨNG tới bản trước (`cp -al`): tệp không đổi không
# tốn thêm chỗ, nên giữ 7 bản chụp tốn xấp xỉ một kho cộng phần tệp mới. Rồi `mc
# mirror --remove` đưa nó về đúng kho hiện tại: tệp mới chép vào, tệp đã xoá khỏi
# kho được GỠ LIÊN KẾT khỏi bản này (bản cũ vẫn giữ).
#
# HAI ĐIỀU giữ cho liên kết cứng an toàn — một lệnh GHI ĐÈ TẠI CHỖ lên tệp dùng
# chung là sửa luôn mọi bản chụp cũ:
#   - KHÔNG `--overwrite`: đối tượng trong kho khoá theo id và không bao giờ được
#     ghi lại, nên không có gì để ghi đè; có cờ ấy thì `mc` sẽ ghi vào inode chung.
#   - CHỈ liên kết thư mục `tep/`. Bảng kê (`ban-ke` ghi bằng `>`) nằm ngoài nó — liên
#     kết cả bản chụp thì `>` cắt cụt bảng kê của bản TRƯỚC.
#
# Máy nâng cấp từ trước `0250` có kho cũ ở `<CU>/<bucket>`: dùng nó làm điểm khởi
# đầu (liên kết, không chép) rồi nói ra là xoá tay được.
CHUP_KHO_TEP='
set -e
# Ảnh MinIO KHÔNG có grep/sed/awk/find (đo 06/11) — lọc tên bản chụp bằng `case`.
cac_ban() {
  for x in "$GOC"/*; do
    b=${x##*/}
    case "$b" in [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) echo "$b" ;; esac
  done | LC_ALL=C sort
}
mkdir -p "$GOC"
# bản dở dang của lượt hỏng trước (bất kỳ mốc nào) — không bao giờ là bản tốt
rm -rf "$GOC"/*.partial
truoc=$(cac_ban | tail -1)
mkdir -p "$GOC/$MOC.partial"
if [ -n "$truoc" ]; then
  cp -al "$GOC/$truoc/tep" "$GOC/$MOC.partial/tep"
elif [ -d "$CU" ] && [ -n "$(ls -A "$CU" 2>/dev/null)" ]; then
  cp -al "$CU" "$GOC/$MOC.partial/tep"
  echo "  GHI CHÚ — kho cũ $CU đã thành điểm khởi đầu; xoá tay được: rm -rf $CU"
else
  mkdir -p "$GOC/$MOC.partial/tep"
fi
# Mirror TỪNG BUCKET, không mirror từ gốc `l`: `mc` của ảnh ghim, mirror gốc sang
# thư mục máy với `--remove`, HỎNG ngay lượt thứ hai dù không gì đổi ("remove
# …/tep/csbh: no such file or directory") — đo 06/11 trên MinIO thật. Theo bucket
# thì chạy lại bao nhiêu lần cũng được. Bucket đã biến khỏi kho thì gỡ thư mục của
# nó khỏi bản chụp này.
# `--quiet` chỉ tắt thanh tiến độ: không có terminal thì `mc` vẫn in MỌI tệp
# (12MB cho kho demo) — đầu ra ấy vào log cron mỗi đêm.
mc ls l > "$GOC/.bucket"
co=" "
while read -r dong; do
  bk=${dong##* }; bk=${bk%/}
  [ -n "$bk" ] || continue
  co="$co$bk "
  mc mirror --remove --quiet "l/$bk" "$GOC/$MOC.partial/tep/$bk" > /dev/null
done < "$GOC/.bucket"
rm -f "$GOC/.bucket"
for d in "$GOC/$MOC.partial/tep"/*/; do
  [ -d "$d" ] || continue
  bk=${d%/}; bk=${bk##*/}
  case "$co" in *" $bk "*) ;; *) rm -rf "$d" ;; esac
done
mv "$GOC/$MOC.partial" "$GOC/$MOC"
cac_ban | head -n "-$GIU" | while read -r cu; do
  echo "  giữ tối đa $GIU bản chụp — xoá $cu"
  rm -rf "$GOC/$cu"
done
'

hoi_mat_khau() {
  stty -echo 2>/dev/null || true
  printf '%s' "$1" >&2; read -r MK; echo "" >&2
  stty echo 2>/dev/null || true
}

# Kéo ảnh, và CHỈ DỪNG khi thiếu ảnh thật (`0107`, gom thành hàm ở `0235`).
#
# Kéo hỏng thì chưa chắc đã phải dừng. Ba tình huống thật: máy chủ không ra được
# registry (mạng cách ly, ảnh nạp bằng `docker load`); bản chạy thử tại chỗ nơi
# ảnh vừa dựng còn nằm trên máy; và một ảnh BÊN THỨ BA biến khỏi registry — đo
# được 29/09: kho `minio/minio` trên Docker Hub trả `pull access denied`, kể cả
# thẻ ghim ta dùng, trong khi máy chủ vẫn giữ nguyên ảnh ấy và MinIO vẫn chạy.
# Tới `0234` chỉ `len` có đường vòng này; `nang-cap` gọi `$DC pull` trần dưới
# `set -e` nên chết ngay sau bước sao lưu.
#
# Nhưng chỉ đi tiếp khi ĐỦ ẢNH. Bỏ qua lỗi rồi `up` với một ảnh thiếu thì
# docker báo "manifest unknown" ở giữa lượt dựng, sau khi vài service đã lên.
keo_anh() {
  $DC pull && return 0
  echo ""
  echo "  Không kéo được một số ảnh từ registry. Kiểm ảnh có sẵn trên máy chưa..."
  thieu=""
  for a in $($DC config --images | sort -u); do
    docker image inspect "$a" >/dev/null 2>&1 || thieu="$thieu $a"
  done
  [ -z "$thieu" ] || {
    echo "  THIẾU ảnh:$thieu" >&2
    echo "  Đăng nhập registry (docker login) rồi thử lại." >&2
    return 1
  }
  echo "  Đủ ảnh trên máy, đi tiếp."
  echo ""
}

# Id container của `cloudflared`, hoặc rỗng khi đường hầm không chạy (`0218`).
#
# `upgrade` dùng nó để ĐO thay vì tin: địa chỉ công khai của một quick tunnel
# chết theo tiến trình `cloudflared`, nên câu *"không dựng lại nó"* phải kiểm
# được, không phải một lời hứa trong chú thích.
id_cloudflared() { $DC ps -q cloudflared 2>/dev/null || true; }

# Kéo BA ảnh `…-latest` của phần mềm, KHÔNG kéo `cloudflared` (`0218`).
#
# Kéo có chọn lọc, không gọi `$DC pull` trần: lệnh trần kéo cả
# `cloudflare/cloudflared:latest`, mà Cloudflare đẩy bản mới vài tuần một lần —
# đúng vào một lượt nâng bản nào đó id ảnh đổi, `up -d` dựng lại container ấy, và
# **địa chỉ công khai đổi theo**. Mọi liên kết trong thư đã gửi chết, mà không ai
# nối được hai việc lại với nhau.
#
# Không kéo được thì chưa chắc phải dừng — cùng lý lẽ `len` (`0107`): máy cách
# ly nạp ảnh bằng `docker load`. Nhưng chỉ đi tiếp khi CẢ BA ảnh có trên máy.
keo_anh_latest() {
  kho="$(doc_env CSBH_IMAGE)"
  thieu=""
  for tp in $ANH_TA; do
    docker pull "${kho}:${tp}-latest" >/dev/null 2>&1 || {
      docker image inspect "${kho}:${tp}-latest" >/dev/null 2>&1 || thieu="$thieu ${kho}:${tp}-latest"
    }
  done
  [ -z "$thieu" ] || {
    echo "  THIẾU ảnh:$thieu" >&2
    echo "  Đăng nhập registry (docker login), hoặc kiểm bên đóng gói đã chạy make day-anh chưa." >&2
    exit 1
  }
}

# Số phiên bản THẬT của ảnh `…-latest`, đọc từ nhãn OCI (`0218`).
#
# Đây là thứ giữ cho hai lý do chống `latest` ở đầu `compose.prod.yml` còn đúng:
# `latest` là một CON TRỎ trên registry, còn thứ được ghi vào `.env` là CON SỐ nó
# trỏ tới. Rỗng nghĩa là ảnh dựng trước `0218`, lúc chưa có nhãn — khi ấy KHÔNG
# rơi về ghi `latest`, mà dừng: đó đúng là trạng thái hai lý do kia cấm.
so_phien_ban() { nhan_anh "$(kho_anh):ops-latest"; }

# --- Ảnh `-latest` và phiên bản (`0270`) ---------------------------------------
#
# Từ `0270` máy chủ chạy THẺ `-latest` cho bốn ảnh của ta (yêu cầu 08/11) — ĐẢO
# luật `0218` "`latest` không bao giờ vào `.env`". Hai lý do của luật ấy được giữ
# bằng cơ chế khác, và hai cơ chế ấy là lý do các hàm dưới đây tồn tại:
#
#   1. "Không biết máy đang chạy bản nào" → ảnh TỰ biết: `APP_VERSION` nướng vào
#      ảnh lúc dựng, và số phiên bản đọc từ NHÃN OCI của ảnh container đang chạy
#      (`phien_ban_may`) — không đọc từ `.env`, nơi không còn con số nào.
#   2. "Một lượt pull đổi thứ đang chạy mà không ai chủ ý" → CHỈ HAI chỗ được kéo
#      ảnh: máy chưa có ảnh (`keo_anh_neu_thieu`) và `cap-nhat`. `len`, khởi động
#      lại máy, chạy lại `cai-dat.sh` đều KHÔNG kéo.
#
# Ảnh MinIO nhân bản cũng là ảnh của kho ta nên cũng chạy `minio-latest`; nó không
# mang nhãn phiên bản phần mềm (nó là MinIO), nên chỉ ba ảnh kia trả lời "bản nào".
ANH_TA="service web ops minio"
kho_anh() { doc_env CSBH_IMAGE; }
nhan_anh() {
  docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$1" 2>/dev/null || true
}

# Phiên bản ĐANG CHẠY: nhãn của ảnh mà container `gateway` đang dùng (theo image ID,
# không theo thẻ — sau lượt kéo, thẻ `-latest` trên máy đã trỏ sang ảnh mới trong khi
# container vẫn chạy ảnh cũ). Hệ chưa chạy thì nhãn của `service-latest` trên máy.
phien_ban_may() {
  id="$($DC ps -q gateway 2>/dev/null | head -1)"
  a="$(kho_anh):service-latest"
  [ -n "$id" ] && a="$(docker inspect -f '{{.Image}}' "$id" 2>/dev/null || echo "$a")"
  v="$(nhan_anh "$a")"
  echo "${v:-không rõ}"
}

# Digest của ảnh trên máy (rỗng: chưa từng kéo/đẩy) và trên registry (rỗng: không hỏi được).
digest_may() {
  docker image inspect -f '{{range .RepoDigests}}{{println .}}{{end}}' "$1" 2>/dev/null | sed -n 's/^[^@]*@//p' | head -1
}
digest_kho() {
  docker buildx imagetools inspect --format '{{json .Manifest.Digest}}' "$1" 2>/dev/null | tr -d '"'
}
nhan_kho() {
  docker buildx imagetools inspect --format '{{index .Image.Config.Labels "org.opencontainers.image.version"}}' "$1" 2>/dev/null || true
}

# Kéo CHỈ KHI máy thiếu ảnh — lý do 2 ở trên. Có đủ thì nói ra là đã KHÔNG kéo, để
# người chờ một bản mới biết đường đúng là `cap-nhat`.
keo_anh_neu_thieu() {
  for a in $($DC config --images | sort -u); do
    docker image inspect "$a" > /dev/null 2>&1 || { keo_anh; return; }
  done
  echo "==> đủ ảnh trên máy — KHÔNG kéo bản mới (muốn cập nhật: ./csbh cap-nhat)"
}

# Thẻ cục bộ giữ đường lùi của một lượt cập nhật. Chỉ nằm trên máy, không bao giờ đẩy.
THE_LUI="truoc-cap-nhat"

# --- Thư mục chương trình theo bản (`0270`) --------------------------------------
#
#   /opt/csbh/releases/<bản>/   csbh · cai-dat.sh · deploy/ · tai-lieu/ (từ `scripts/ban-cai.sh`)
#   /opt/csbh/current -> releases/<bản>
#
# `cap-nhat` bung chương trình ĐI KÈM ảnh ops mới vào `releases/<bản mới>/`, chạy
# migration + dựng lại bằng CHÍNH compose ấy, xong mới đổi `current`. Hết bẫy *"nâng
# cấp chỉ đổi ảnh, compose phải chép tay"*. Chỉ áp khi `csbh` đang chạy từ cây ấy —
# máy phát triển và bộ kiểm chạy từ một thư mục thường, nhánh này tự tắt.
GOC_CT="${CSBH_CHUONG_TRINH:-/opt/csbh}"
co_cay_ban() { [ -d "$GOC_CT/releases" ] && [ -L "$GOC_CT/current" ]; }

# bung_ban <bản> — chương trình đi kèm ảnh `ops-latest` TRÊN MÁY vào releases/<bản>.
bung_ban() {
  rm -rf "$GOC_CT/releases/$1.partial"
  mkdir -p "$GOC_CT/releases/$1.partial"
  docker run --rm -e CSBH_IMAGE="$(kho_anh)" -v "$GOC_CT/releases/$1.partial:/ra" \
    "$(kho_anh):ops-latest" ban-cai /ra > /dev/null || { rm -rf "$GOC_CT/releases/$1.partial"; return 1; }
  rm -rf "$GOC_CT/releases/$1"
  mv "$GOC_CT/releases/$1.partial" "$GOC_CT/releases/$1"
}

# Đổi `current` NGUYÊN TỬ (liên kết tạm rồi `mv -T`): không có khoảnh khắc nào
# `current` vắng mặt — cron và tác tử gọi `/opt/csbh/current/csbh` bất cứ lúc nào.
doi_current() {
  ln -sfn "releases/$1" "$GOC_CT/current.tam"
  mv -T "$GOC_CT/current.tam" "$GOC_CT/current"
}

# Giữ 3 bản gần nhất, KHÔNG BAO GIỜ xoá bản `current` trỏ tới.
don_ban_cu() {
  dang="$(basename "$(readlink "$GOC_CT/current")")"
  ls -1t "$GOC_CT/releases" | grep -v '\.partial$' | tail -n +4 | while read -r b; do
    [ "$b" = "$dang" ] || rm -rf "${GOC_CT:?}/releases/$b"
  done
}

# Trả mọi `-truoc-cap-nhat` về `-latest` (lùi ảnh). Thiếu một cái thì không đụng cái nào.
tra_anh_cu() {
  k="$(kho_anh)"
  for tp in $ANH_TA; do
    docker image inspect "${k}:${tp}-${THE_LUI}" > /dev/null 2>&1 || {
      echo "  Không có ảnh ${k}:${tp}-${THE_LUI} để lùi về." >&2; return 1; }
  done
  for tp in $ANH_TA; do docker tag "${k}:${tp}-${THE_LUI}" "${k}:${tp}-latest"; done
}

# Migration mới nhất CSDL đã chạy (tên tệp), để `lui-lai` biết có lùi ảnh được không.
# --- Chồng kiểm nghiệm (`0270`) ------------------------------------------------------
#
# Một chồng production THỨ HAI từ CÙNG ảnh `-latest` đang có trên máy (ở `cap-nhat`: ảnh MỚI
# vừa kéo) và CÙNG compose của bản cài (`$CT`), cộng `compose.kiem.yml`. Dự án `csbh-kiem`:
# volume, mạng, container riêng; không `compose.du-lieu.yml` (dữ liệu giả ở volume thường);
# không cổng; thư vào hộp thư giả. Chạy `scripts/kiem-nghiem.ts`, rồi DỌN SẠCH dù xanh hay
# đỏ — kể cả khi bị Ctrl-C (`BUOC_KHI_THOAT`, một trap EXIT duy nhất với phần hiển thị bước).
#
# MÔI TRƯỜNG SẠCH (`env -i`): `csbh` đã xuất các biến của chồng THẬT (`SITE_URL`,
# `MAIL_PASSWORD_FILE`, `CSBH_WORKSPACE`…) và biến môi trường THẮNG `--env-file` — để chúng
# lọt vào là chồng kiểm gắn `secrets/` của hệ thật. Nên compose của chồng kiểm chỉ nhận
# đúng những biến khai dưới đây.
DU_AN_KIEM=csbh-kiem
KIEM_DIR=""

dc_kiem() {
  env -i PATH="$PATH" HOME="${HOME:-/root}" \
    CSBH_WORKSPACE="$KIEM_DIR" CSBH_LOG_DIR="$KIEM_DIR/logs" CSBH_LOG_ARCHIVE="$KIEM_DIR/logarchive" \
    CSBH_BACKUP_MIRROR="$KIEM_DIR/mirror" MAIL_PASSWORD_FILE="" GOOGLE_CLIENT_SECRET_FILE="" \
    docker compose -p "$DU_AN_KIEM" --env-file "$KIEM_DIR/kiem.env" \
      -f "$CT/deploy/compose.yml" -f "$CT/deploy/compose.prod.yml" -f "$CT/deploy/compose.kiem.yml" "$@"
}

# Gỡ MỌI thứ mang nhãn dự án `csbh-kiem` — theo NHÃN chứ không theo tệp compose, nên dọn
# được cả tàn dư của một lượt chết dở mà thư mục tạm đã mất.
don_kiem() {
  [ -n "$KIEM_DIR" ] && [ -f "$KIEM_DIR/kiem.env" ] && dc_kiem down -v --remove-orphans > /dev/null 2>&1 || true
  for x in $(docker ps -aq --filter "label=com.docker.compose.project=$DU_AN_KIEM" 2> /dev/null); do docker rm -f "$x" > /dev/null 2>&1 || true; done
  for x in $(docker volume ls -q --filter "label=com.docker.compose.project=$DU_AN_KIEM" 2> /dev/null); do docker volume rm -f "$x" > /dev/null 2>&1 || true; done
  for x in $(docker network ls -q --filter "label=com.docker.compose.project=$DU_AN_KIEM" 2> /dev/null); do docker network rm "$x" > /dev/null 2>&1 || true; done
  # Tệp container ghi (log, bí mật) thuộc root — xoá qua một container, không xoá thẳng.
  if [ -n "$KIEM_DIR" ] && [ -d "$KIEM_DIR" ]; then
    docker run --rm --entrypoint sh -v "$(dirname "$KIEM_DIR"):/t" "$(kho_anh):ops-latest" \
      -c "rm -rf /t/$(basename "$KIEM_DIR")" > /dev/null 2>&1 || rm -rf "$KIEM_DIR" 2> /dev/null || true
  fi
}

# Đếm thứ còn sót của dự án `csbh-kiem` (container + volume + mạng). Phải ra 0.
con_sot_kiem() {
  { docker ps -aq --filter "label=com.docker.compose.project=$DU_AN_KIEM"
    docker volume ls -q --filter "label=com.docker.compose.project=$DU_AN_KIEM"
    docker network ls -q --filter "label=com.docker.compose.project=$DU_AN_KIEM"; } 2> /dev/null | grep -c . || true
}

# GIỮ CHỨNG CỨ trước khi dọn (`0270`, hỏi 08/11 khi bước 10 đỏ trên VPS): lượt dọn xoá cả
# log của từng service trong chồng kiểm — đúng thứ cần để gỡ lỗi. Nên khi một bước của chồng
# kiểm hỏng, chép ra `logs/kiem-nghiem/<giờ>-loi/`: log dựng, trạng thái container, healthcheck
# của container không khoẻ, và đuôi log của MỌI service. Đó là tệp log trong thư mục log, không
# phải dữ liệu hệ thống — hệ vẫn "sạch". Không chứa mật khẩu: bí mật nằm ở tệp, không in ra log.
giu_log_kiem() {
  noi="$WS/logs/kiem-nghiem/$(date +%Y%m%d-%H%M%S)-loi"
  mkdir -p "$noi"
  [ -f "$KIEM_DIR/dung.log" ] && cp "$KIEM_DIR/dung.log" "$noi/dung.log"
  dc_kiem ps -a > "$noi/container.txt" 2>&1 || true
  for c in $(docker ps -aq --filter "label=com.docker.compose.project=$DU_AN_KIEM" 2> /dev/null); do
    ten="$(docker inspect -f '{{.Name}}' "$c" 2> /dev/null | tr -d /)"
    docker logs --timestamps --tail 400 "$c" > "$noi/$ten.log" 2>&1 || true
    docker inspect -f '{{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} restart={{.RestartCount}}{{if .State.Health}} health={{.State.Health.Status}}{{range .State.Health.Log}}
  {{.Start}} -> {{.ExitCode}}: {{.Output}}{{end}}{{end}}' "$c" > "$noi/$ten.trang-thai.txt" 2>&1 || true
  done
  free -m > "$noi/may.txt" 2>&1 || true; df -h "$WS" >> "$noi/may.txt" 2>&1 || true
  echo "  Đã giữ log của chồng kiểm để gỡ lỗi: $noi" >&2
  [ -f "$noi/dung.log" ] && tail -20 "$noi/dung.log" >&2
}

# kiem_nghiem_chay — trả 0 khi XANH HẾT. In từng việc con thụt vào; báo cáo đầy đủ ghi ở
# `<workspace>/logs/kiem-nghiem/<giờ>.txt` (tệp log, không phải dữ liệu hệ thống).
kiem_nghiem_chay() {
  k="$(kho_anh)"
  echo "    ▸ dọn tàn dư của lượt kiểm nghiệm trước (nếu có)"
  KIEM_DIR=""; don_kiem
  # Thư mục tạm của lượt chết dở: tệp do container ghi thuộc root — xoá qua container.
  for d in "$WS/tmp"/kiem-*; do [ -d "$d" ] && { KIEM_DIR="$d"; don_kiem; KIEM_DIR=""; }; done
  # Hai chồng cùng chạy (ở `cap-nhat`) — thiếu RAM thì DỪNG và nói con số, không để máy
  # chủ thật bị OOM giữa lượt kiểm.
  con="$(free -m 2> /dev/null | awk '/^Mem:/ {print $NF}')"
  can="${CSBH_KIEM_RAM_MB:-2500}"
  case "$con" in ''|*[!0-9]*) ;; *)
    [ "$con" -ge "$can" ] || { echo "  RAM trống ${con} MB — chồng kiểm nghiệm cần ${can} MB. Nâng RAM VPS hoặc tắt bớt thứ khác." >&2; return 1; } ;;
  esac
  KIEM_DIR="$WS/tmp/kiem-$(date +%Y%m%d%H%M%S)"
  BUOC_KHI_THOAT="${BUOC_KHI_THOAT:+$BUOC_KHI_THOAT; }don_kiem"
  mkdir -p "$KIEM_DIR/secrets" "$KIEM_DIR/logs" "$KIEM_DIR/logarchive" "$KIEM_DIR/mirror" "$WS/logs/kiem-nghiem"
  cat > "$KIEM_DIR/kiem.env" <<HET
COMPOSE_PROJECT_NAME=$DU_AN_KIEM
CSBH_IMAGE=$k
SITE_ADDRESS=:80
SITE_URL=http://kiem.local
ACME_EMAIL=kiem@kiem.test
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=csbh@kiem.test
MAIL_ALLOWLIST=kiem.test
MAIL_USER=
MAIL_SECURE=
MAIL_STARTTLS=false
HET
  echo "    ▸ sinh bí mật RIÊNG cho chồng kiểm"
  docker run --rm --user "$NGUOI" -v "$KIEM_DIR/secrets:/run/secrets" "$k:ops-latest" gen-secrets /run/secrets > /dev/null || return 1
  mk="Kn$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')9"
  ( umask 077; printf '%s' "$mk" > "$KIEM_DIR/secrets/admin_mat_khau.txt" )
  echo "    ▸ dựng chồng kiểm (dự án $DU_AN_KIEM, không cổng, thư vào hộp thư giả)"
  dc_kiem run --rm -T ops migrate > "$KIEM_DIR/dung.log" 2>&1 || { giu_log_kiem; return 1; }
  dc_kiem up -d --wait >> "$KIEM_DIR/dung.log" 2>&1 || { giu_log_kiem; return 1; }
  dc_kiem run --rm -T -e ADMIN_USERNAME=admin -e ADMIN_EMAIL=admin@kiem.test -e "ADMIN_FULL_NAME=Quản trị kiểm nghiệm" \
    -e ADMIN_PASSWORD_FILE=/run/secrets/admin_mat_khau.txt ops bootstrap-admin >> "$KIEM_DIR/dung.log" 2>&1 \
    || { giu_log_kiem; return 1; }
  echo "    ▸ chạy bộ kiểm nghiệm"
  bao_cao="$WS/logs/kiem-nghiem/$(date +%Y%m%d-%H%M%S).txt"
  set +e
  dc_kiem run --rm -T -e KIEM_ADMIN=admin -e "KIEM_ADMIN_MAT_KHAU=$mk" -e KIEM_MIEN_THU=kiem.test \
    -e GATEWAY_URL=http://gateway:3000 -e MAILPIT_URL=http://mailpit:8025 ops kiem-nghiem 2>&1 \
    | tee "$bao_cao" | sed 's/^/      /'
  set -e
  # `sh` không có PIPESTATUS: đọc kết quả từ CHÍNH dòng tổng kết của báo cáo.
  dong="$(grep -E '^KIEM_NGHIEM [0-9]+/[0-9]+$' "$bao_cao" | tail -1)"
  xanh="$(echo "$dong" | sed -E 's/^KIEM_NGHIEM ([0-9]+)\/([0-9]+)$/\1/')"
  tong="$(echo "$dong" | sed -E 's/^KIEM_NGHIEM ([0-9]+)\/([0-9]+)$/\2/')"
  # Đỏ (hoặc không tới được dòng tổng kết) thì giữ log service TRƯỚC khi dọn — câu lỗi của một
  # ca chỉ nói mã HTTP, nguyên nhân nằm trong log của service.
  if [ -z "$dong" ] || [ "$xanh" != "$tong" ]; then giu_log_kiem; fi
  echo "    ▸ dọn sạch chồng kiểm (dữ liệu giả, volume, mạng, thư mục tạm)"
  don_kiem; KIEM_DIR=""
  sot="$(con_sot_kiem)"
  [ "${sot:-0}" = 0 ] || { echo "  DỌN KHÔNG SẠCH: còn $sot container/volume/mạng của dự án $DU_AN_KIEM — xem: docker ps -a; docker volume ls" >&2; return 3; }
  echo "    Báo cáo: $bao_cao"
  [ -n "$dong" ] || { echo "  Bộ kiểm nghiệm không chạy tới dòng tổng kết — xem báo cáo." >&2; return 1; }
  if [ "$xanh" != "$tong" ]; then
    echo "  KIỂM NGHIỆM ĐỎ: $xanh/$tong ca xanh." >&2
    return 1
  fi
  echo "    Kiểm nghiệm XANH: $xanh/$tong ca."
}

migration_cuoi() {
  q_ops "SELECT filename FROM sys.schema_migration ORDER BY filename DESC LIMIT 1"
}

# --- Hiển thị BƯỚC (`0270`) — ở `lib-buoc.sh`, dùng chung với `cai-dat.sh`. ---------
. "$CT/lib-buoc.sh"

# --- Tác tử vận hành (`0254`) ------------------------------------------------
#
# Vòng lặp chạy NGOÀI container (systemd, `deploy/systemd/csbh-tac-tu.service`) với quyền
# docker của máy chủ — container không bao giờ cầm `docker.sock` (chốt 05/11). Nói chuyện
# với ứng dụng CHỈ QUA CSDL, và mọi câu SQL là một lời gọi hàm `ops.*` (migration `0127`):
# shell chuyển nguyên văn đầu ra của docker, phân tích nằm ở SQL.
#
# Mỗi nhịp (mặc định 10 giây): nhịp tim + nhận một việc web đang chờ; mỗi phút ghi trạng
# thái container; mỗi 5 phút thu log sáu container hạ tầng vào thư mục log chung; mỗi giờ
# đo cỡ volume và ảnh Docker.
#
# SAO LƯU THEO LỊCH KHÔNG đi qua đây — cron vẫn là bộ đếm giờ. Tác tử chết thì nút "Sao lưu
# ngay" xám, còn bản sao lưu hằng đêm vẫn có.

# Một câu SQL qua `exec` vào container Postgres đang chạy (`run --rm ops` mỗi 10 giây là
# dựng một container mỗi nhịp). SQL đi qua STDIN: đầu ra `docker system df -v` có thể dài.
q_pg() { printf '%s\n' "$1" | $DC exec -T postgres psql -U postgres -d csbh -v ON_ERROR_STOP=1 -qtA -f - 2>/dev/null; }

HA_TANG="postgres redis rabbitmq minio gotenberg caddy"
TT="${RUN:-.}/tac-tu"   # trạng thái của tác tử trong workspace: mốc log, mốc các việc định kỳ

bay_gio_giay() { echo "${CSBH_EPOCH:-$(date +%s)}"; }     # CSBH_EPOCH: chỉ bộ kiểm đặt
den_luot() { [ "$(( $(bay_gio_giay) - $(cat "$TT/luot-$1" 2>/dev/null || echo 0) ))" -ge "$2" ]; }
danh_dau() { bay_gio_giay > "$TT/luot-$1"; }

# Dấu thời gian Docker + 1 nano giây — `--since` là "lớn hơn HOẶC BẰNG" (xem `luu-log.sh`).
moc_sau() {
  awk -v t="$1" 'BEGIN {
    n = split(t, a, "."); if (n < 2) { print t; exit }
    giay = a[1]; le = a[2]; sub(/Z$/, "", le); moi = le + 1
    if (length(moi) > length(le)) { print t; exit }
    p = "" moi; while (length(p) < length(le)) p = "0" p
    printf "%s.%sZ\n", giay, p }'
}

# Log hạ tầng vào `<CSBH_LOG_DIR>/dang-ghi/<service>-<ngày VN>.log` — cùng chỗ, cùng tên với
# tệp của mười một service Node, nên lượt nén hằng đêm của `van-hanh` gom luôn chúng.
#
# Ghi QUA CONTAINER `van-hanh` (`exec … cat >>`), không ghi thẳng trên máy chủ: các service
# tạo thư mục log bằng tài khoản TRONG container (root ở demo), tác tử chạy bằng một tài khoản
# thường — ghi thẳng là `Permission denied` (dựng thật ở `0254` bắt được, bộ kiểm thì không).
# Đi qua container thì tệp cùng chủ với mọi tệp log khác, và lượt nén xoá được chúng.
#
# Dòng trước nửa đêm VN (17:00Z hôm qua) vào tệp HÔM QUA: lượt thu lúc 00:03 không được đẩy
# năm phút cuối của ngày cũ sang ngày mới. Con trỏ mốc chỉ tiến khi MỌI phần đã ghi xong —
# `van-hanh` không chạy thì lượt sau thu lại từ mốc cũ, không mất dòng nào.
ghi_log() { $DC exec -T van-hanh sh -c 'mkdir -p /var/log/csbh/dang-ghi && cat >> "/var/log/csbh/dang-ghi/$1"' _ "$1"; }

thu_log_ha_tang() {
  mkdir -p "$TT/moc-log"
  hom_nay="${CSBH_HOM_NAY:-$(TZ=Asia/Ho_Chi_Minh date +%Y-%m-%d)}"
  hom_qua="${CSBH_HOM_QUA:-$(TZ=Asia/Ho_Chi_Minh date -d '-1 day' +%Y-%m-%d 2>/dev/null || true)}"
  for svc in $HA_TANG; do
    moc="$TT/moc-log/$svc"
    since=""; [ -s "$moc" ] && since="--since $(cat "$moc")"
    tam="$(mktemp)"
    # shellcheck disable=SC2086
    if ! $DC logs --no-color --no-log-prefix --timestamps $since "$svc" > "$tam" 2>/dev/null || [ ! -s "$tam" ]; then
      rm -f "$tam"; continue
    fi
    ok=1
    if [ -n "$hom_qua" ]; then
      awk -v r="${hom_qua}T17:00:00" -v a="$tam.qua" -v b="$tam.nay" \
        '{ if (substr($1, 1, 19) < r) print > a; else print > b }' "$tam"
      [ -s "$tam.qua" ] && { ghi_log "$svc-$hom_qua.log" < "$tam.qua" || ok=0; }
      [ -s "$tam.nay" ] && { ghi_log "$svc-$hom_nay.log" < "$tam.nay" || ok=0; }
    else
      ghi_log "$svc-$hom_nay.log" < "$tam" || ok=0
    fi
    if [ "$ok" = 1 ]; then
      cuoi="$(tail -n 1 "$tam" | cut -d' ' -f1)"
      [ -n "$cuoi" ] && moc_sau "$cuoi" > "$moc"
    else
      echo "tac-tu: không ghi được log $svc qua van-hanh — lượt sau thu lại từ mốc cũ" >&2
    fi
    rm -f "$tam" "$tam.qua" "$tam.nay"
  done
}

ghi_container() {
  q_pg "SELECT ops.ghi_container(\$csbh_j\$$($DC ps -a --format json 2>/dev/null)\$csbh_j\$)" > /dev/null
}

ghi_docker() {
  du_an="$(doc_env COMPOSE_PROJECT_NAME)"
  q_pg "SELECT ops.ghi_docker(\$csbh_j\$$du_an\$csbh_j\$,
          \$csbh_j\$$(docker system df --format json 2>/dev/null)\$csbh_j\$,
          \$csbh_j\$$(docker system df -v --format json 2>/dev/null)\$csbh_j\$)" > /dev/null
}

# Một việc web. DANH SÁCH TRẮNG: chỉ tên việc trong `case` dưới đây được chạy, và không
# trường nào của dòng CSDL đi vào dòng lệnh — `id` phải là số, người bấm phải là uuid.
chay_viec_tay() {
  id=$1; loai=$2; nguoi=$3
  # Luôn trả 0: hàm này KHÔNG được gọi sau `||`/`&&`/`if` — trong ngữ cảnh ấy shell tắt
  # `set -e` cho cả thân hàm, KỂ CẢ subshell `( set -e; … )` của `chay_theo_lich`, và một lượt
  # sao lưu hỏng giữa chừng báo THÀNH CÔNG (đo được ở `0254`, cùng lớp bẫy `0251`).
  case "$id" in ''|*[!0-9]*) echo "tac-tu: bỏ việc mang mã lạ" >&2; return 0 ;; esac
  ra="$(mktemp)"
  case "$loai" in
    SAO_LUU_CSDL)    viec="SAO_LUU_CSDL 7 0115 sao_luu_csdl" ;;
    SAO_LUU_KHO_TEP) viec="SAO_LUU_KHO_TEP 7 0200 sao_luu_kho_tep" ;;
    *) viec="" ;;
  esac
  if [ -z "$viec" ]; then
    echo "Việc '$loai' không có trong danh sách được phép chạy." > "$ra"; ma=1
  else
    set +e
    # shellcheck disable=SC2086
    ( set -- $viec; CSBH_NGUOI_CHAY="$nguoi"; chay_theo_lich "$1" "$2" "$3" "" "$4" ) > "$ra" 2>&1
    ma=$?
    set -e
  fi
  ok=false; [ "$ma" = 0 ] && ok=true
  q_pg "SELECT ops.tac_tu_xong($id, $ok, \$csbh_ra\$$(tail -n 60 "$ra")\$csbh_ra\$)" > /dev/null || true
  echo "tac-tu: việc $id ($loai) xong — mã $ma"
  rm -f "$ra"
}

tac_tu_mot_nhip() {
  mkdir -p "$TT"
  # Một việc một lúc. Tệp dấu do CHÍNH việc ấy gỡ khi xong — không dò bằng `kill -0`: tiến
  # trình đã xong mà shell chưa thu về vẫn trả "còn sống".
  ranh=true; [ -f "$TT/viec-dang-chay" ] && ranh=false
  pb="$(phien_ban_may)"
  if ! viec="$(q_pg "SELECT ops.tac_tu_nhip(\$csbh_j\$$pb\$csbh_j\$, \$csbh_j\$$(hostname 2>/dev/null)\$csbh_j\$, $ranh)")"; then
    echo "tac-tu: không nối được CSDL — thử lại ở nhịp sau" >&2
    return 1
  fi
  if [ -n "$viec" ]; then
    # shellcheck disable=SC2086
    set -- $viec
    if [ "${TAC_TU_MOT_NHIP:-0}" = 1 ]; then chay_viec_tay "$1" "$2" "$3"
    else
      # Nền: nhịp tim không được đợi một lượt sao lưu dài, nếu không trang báo mất liên lạc.
      : > "$TT/viec-dang-chay"
      ( chay_viec_tay "$1" "$2" "$3"; rm -f "$TT/viec-dang-chay" ) &
    fi
  fi
  if den_luot container 60; then ghi_container || true; danh_dau container; fi
  if den_luot log 300; then thu_log_ha_tang || true; danh_dau log; fi
  if den_luot docker 3600; then ghi_docker || true; danh_dau docker; fi
  return 0
}

case "${1:-help}" in
  tac-tu)
    case "${2:-}" in
      --mot-nhip) TAC_TU_MOT_NHIP=1; tac_tu_mot_nhip ;;
      '') echo "tac-tu: chạy, nhịp ${TAC_TU_NHIP:-10} giây"
          # Khởi động lại thì không việc nào còn chạy: gỡ dấu cũ, và việc web đang
          # "chạy" dở ở lượt trước thành LỖI thay vì treo mãi (chặn nút bấm của loại ấy).
          mkdir -p "$TT"; rm -f "$TT/viec-dang-chay"
          q_pg "SELECT ops.tac_tu_khoi_dong()" > /dev/null || true
          # KHÔNG `tac_tu_mot_nhip || true` — xem chú thích ở `chay_viec_tay`.
          while :; do
            set +e; tac_tu_mot_nhip; set -e
            sleep "${TAC_TU_NHIP:-10}"
          done ;;
      *) echo "Dùng: ./csbh tac-tu [--mot-nhip]" >&2; exit 2 ;;
    esac ;;
  len)
    buoc_tong 3
    # Kéo CHỈ KHI thiếu ảnh (`0270`); kéo hỏng mà đủ ảnh thì đi tiếp — xem `keo_anh`.
    buoc "Kiểm ảnh trên máy, cập nhật bí mật từ csbh.env"
    dong_bo_bi_mat
    keo_anh_neu_thieu || exit 1
    # `migrate` chạy TRƯỚC, và là điều kiện của mọi service — `depends_on` đã khai
    # `service_completed_successfully`, nên `up -d` tự chờ. Gọi riêng ở đây để
    # người vận hành thấy kết quả migration thay vì thấy nó trôi trong log chung.
    buoc "Chạy migration CSDL"
    $DC run --rm -T ops migrate
    buoc "Dựng các service và chờ healthcheck"
    $DC up -d --wait
    buoc_xong
    echo ""
    echo "  Xong — phiên bản $(phien_ban_may). Mở $SITE_URL"
    ;;
  xuong)        $DC down ;;
  trang-thai)   $DC ps ;;
  log)          shift; $DC logs --tail=200 -f "$@" ;;
  phien-ban)    phien_ban_may ;;

  nang-cap)
    # Gỡ ở `0270`: máy chủ không còn thẻ số nào để nâng tới.
    echo "Lệnh nang-cap đã thay bằng: ./csbh cap-nhat  (kéo bản latest mới nhất, có sao lưu và đường lùi)" >&2
    exit 2 ;;

  cap-nhat)
    # =====================================================================
    # CẬP NHẬT LÊN BẢN `latest` MỚI NHẤT, GIỮ DỮ LIỆU (`0270`).
    # =====================================================================
    #
    # THỨ TỰ là toàn bộ sự an toàn của lệnh này:
    #   1. hỏi registry BẰNG DIGEST, KHÔNG kéo — không có bản mới thì không đụng gì;
    #   2. SAO LƯU bằng ảnh `ops` ĐANG có trên máy — kéo trước thì sao lưu chạy bằng
    #      ảnh mới (đúng bẫy `pg_archivecleanup` của `0234`);
    #   3. gắn `-truoc-cap-nhat` lên ảnh đang chạy — đường lùi;
    #   4. kéo. Container vẫn chạy ảnh cũ (Docker giữ image ID), nên tới đây hệ
    #      chưa bị đụng; kéo hỏng thì trả thẻ cũ và DỪNG;
    #   5. migration rồi dựng lại.
    k="$(kho_anh)"
    buoc_tong 7
    buoc "Hỏi registry có bản mới không"
    cu="$(phien_ban_may)"
    moi_co=""
    for tp in $ANH_TA; do
      dk="$(digest_kho "${k}:${tp}-latest")"
      [ -n "$dk" ] || { echo "  Không hỏi được registry về ${k}:${tp}-latest — đăng nhập registry (docker login) rồi thử lại." >&2; exit 1; }
      [ "$dk" = "$(digest_may "${k}:${tp}-latest")" ] || moi_co="$moi_co $tp"
    done
    if [ -z "$moi_co" ]; then
      buoc_bo "đang là bản mới nhất, các bước còn lại không cần chạy"
      echo ""; echo "  Đang là bản mới nhất (${cu}). Không đổi gì."
      exit 0
    fi
    moi="$(nhan_kho "${k}:ops-latest")"
    echo "  Có bản mới: ${cu} → ${moi:-không rõ}   (ảnh đổi:${moi_co})"

    buoc "Sao lưu CSDL trước khi cập nhật"
    ops backup

    buoc "Giữ đường lùi (gắn thẻ ${THE_LUI})"
    for tp in $ANH_TA; do
      docker image inspect "${k}:${tp}-latest" > /dev/null 2>&1 && docker tag "${k}:${tp}-latest" "${k}:${tp}-${THE_LUI}"
    done
    migration_cuoi > "$RUN/migration-truoc-cap-nhat" || true

    buoc "Kéo ảnh mới"
    for tp in $ANH_TA; do
      docker pull "${k}:${tp}-latest" > /dev/null || {
        tra_anh_cu || true
        echo "  Kéo ${k}:${tp}-latest hỏng. Đã trả ảnh cũ; hệ vẫn chạy bản ${cu}, chưa bị đụng." >&2
        exit 1
      }
    done
    # Chương trình (compose · csbh · tài liệu) ĐI KÈM ảnh mới: bung vào releases/<bản>,
    # rồi mọi bước sau chạy bằng compose ấy. `current` CHƯA đổi — hỏng là còn nguyên bản cũ.
    if co_cay_ban; then
      so="$(nhan_anh "${k}:ops-latest")"; so="${so:-moi}"
      readlink "$GOC_CT/current" > "$RUN/release-truoc-cap-nhat"
      bung_ban "$so" || {
        tra_anh_cu || true
        echo "  Không bung được chương trình của bản ${so}. Đã trả ảnh cũ; hệ vẫn chạy bản ${cu}." >&2
        exit 1
      }
      CT="$GOC_CT/releases/$so"; dat_workspace
    fi

    # KIỂM NGHIỆM ẢNH MỚI trên chồng kiểm riêng (`0270`) — TRƯỚC migration: tới đây chồng
    # thật chưa khởi động lại, CSDL chưa chạy migration mới nào. Đỏ thì trả ảnh cũ và DỪNG.
    buoc "Kiểm nghiệm bản mới trên chồng kiểm riêng (dữ liệu giả, dọn sạch sau)"
    kiem_nghiem_chay || {
      tra_anh_cu || true
      echo "  Bản mới KHÔNG qua kiểm nghiệm. Đã trả ảnh cũ; hệ vẫn chạy bản ${cu}, chưa bị đụng." >&2
      exit 1
    }

    buoc "Chạy migration CSDL"
    dong_bo_bi_mat
    $DC run --rm -T ops migrate || {
      echo "  Migration hỏng. Dữ liệu có thể đã đổi một phần — lùi bằng bản sao lưu vừa tạo:" >&2
      echo "    ./csbh phuc-hoi <tệp mới nhất>   rồi   ./csbh lui-lai" >&2
      exit 1
    }

    buoc "Dựng lại các service và chờ healthcheck"
    $DC up -d --wait || {
      echo "  Dựng lại hỏng. Lùi về bản ${cu}:  ./csbh lui-lai" >&2
      exit 1
    }
    if co_cay_ban; then doi_current "$so"; don_ban_cu; fi
    buoc_xong
    echo ""
    echo "  Xong: ${cu} → $(phien_ban_may)."
    echo "  Lùi lại (khi cần, chỉ được khi bản mới chưa thêm migration): ./csbh lui-lai"
    ;;

  kiem-nghiem)
    # Chạy tay một lượt kiểm nghiệm trên chồng kiểm riêng (`0270`) — với ảnh đang có trên máy.
    buoc_tong 1
    buoc "Kiểm nghiệm đủ chức năng trên chồng kiểm riêng"
    kiem_nghiem_chay
    buoc_xong ;;

  lui-lai)
    # Về ảnh `-truoc-cap-nhat`. MIGRATION KHÔNG LÙI ĐƯỢC: nếu lượt cập nhật đã chạy
    # migration mới thì ảnh cũ sẽ chạy trên một lược đồ nó không biết — trạng thái
    # không ai kiểm. Khi ấy DỪNG và chỉ sang phục hồi từ bản sao lưu, không đoán hộ.
    buoc_tong 3
    buoc "Kiểm có lùi ảnh được không"
    truoc="$(cat "$RUN/migration-truoc-cap-nhat" 2>/dev/null || true)"
    nay="$(migration_cuoi)"
    if [ -z "$truoc" ] || [ "$truoc" != "$nay" ]; then
      cat >&2 <<HET
  KHÔNG lùi ảnh được: CSDL đã chạy migration ${nay:-?} sau lượt cập nhật (trước đó: ${truoc:-không rõ}).
  Ảnh cũ không biết lược đồ mới. Đường đúng:
    1. ./csbh phuc-hoi <bản sao lưu tạo lúc cập nhật>
    2. ./csbh lui-lai
HET
      exit 1
    fi
    buoc "Trả ảnh về bản trước cập nhật"
    tra_anh_cu
    # Chương trình cũng về bản trước (compose của ảnh cũ).
    truoc_ct="$(cat "$RUN/release-truoc-cap-nhat" 2>/dev/null || true)"
    if co_cay_ban && [ -n "$truoc_ct" ] && [ -d "$GOC_CT/$truoc_ct" ]; then
      doi_current "$(basename "$truoc_ct")"
      CT="$GOC_CT/$truoc_ct"; dat_workspace
    fi
    buoc "Dựng lại các service và chờ healthcheck"
    $DC up -d --wait
    buoc_xong
    echo ""; echo "  Đã lùi về bản $(phien_ban_may)."
    ;;

  upgrade)
    # ==================================================================
    # LÊN BẢN MỚI NHẤT, XOÁ SẠCH DỮ LIỆU, GIỮ NGUYÊN ĐỊA CHỈ (`0218`).
    # ==================================================================
    #
    # Khác `cap-nhat` ở MỘT chuyện (từ `0270` cả hai cùng kéo `-latest`):
    #
    #   CSDL dựng lại từ TRỐNG và kho tệp dọn sạch — không hoàn tác được, nên
    #      bản mới bắt đầu lại từ bước tạo tài khoản Quản trị.
    #
    # Dùng cho bản chạy thử cần thử lại từ đầu trên mã mới. KHÔNG dùng cho hệ
    # có dữ liệu thật — ở đó là `cap-nhat`.
    #
    # BA THỨ KHÔNG ĐƯỢC ĐỤNG TỚI, mỗi thứ một lý do:
    #
    #   * `cloudflared` — địa chỉ quick tunnel chết theo tiến trình, nên dựng
    #     lại nó là đổi địa chỉ công khai và giết mọi liên kết trong những lá
    #     thư đã gửi. Ở đây nó được ĐO, xem `id_cloudflared`.
    #   * `.env` — `SITE_URL` đang mang địa chỉ đường hầm,
    #     và mười service đọc nó.
    #   * volume `pgdata` — xoá volume là mất luôn mật khẩu Postgres đã khởi
    #     tạo (`0106`), và mọi thứ sau đó hỏng với "password authentication
    #     failed". Xoá CSDL thì đủ, và `reset-db.sh` làm đúng thế.
    cu="$(phien_ban_may)"

    # ĐỌC SỐ TRƯỚC KHI HỎI, KHÔNG KÉO (`0270`): số của bản mới đọc thẳng từ nhãn trên
    # registry, nên người vận hành thấy mình sắp lên BẢN NÀO ngay lúc gõ xác nhận. Kéo
    # để SAU bước sao lưu — từ `0270` thẻ `-latest` trên máy là thứ compose chạy, kéo
    # trước thì lượt sao lưu chạy bằng ảnh `ops` mới thay vì bản đã ghi dữ liệu.
    moi="$(nhan_kho "$(kho_anh):ops-latest")"
    [ -n "$moi" ] || {
      echo "  Không đọc được phiên bản của ops-latest trên registry." >&2
      echo "  Đăng nhập registry (docker login), hoặc kiểm bên đóng gói đã chạy make day-anh chưa." >&2
      exit 1
    }

    cat <<HET

  Bản đang chạy:   ${cu}
  Sẽ lên bản:      ${moi}   (mới nhất trên registry)

  CẢNH BÁO — việc này XOÁ SẠCH dữ liệu của bản đang chạy:

    · mọi hồ sơ CSBH, khách hàng, danh mục sản phẩm và quy định chiết khấu
    · MỌI TÀI KHOẢN, kể cả tài khoản Quản trị
    · mọi tệp đã tải lên và mọi bản mềm đã lưu
    · toàn bộ nhật ký kiểm toán

  Xong rồi thì phải làm lại hai bước cài đặt:
    ./csbh mo-tai-khoan     rồi    ./csbh nap-danh-muc

  Muốn cập nhật mà GIỮ dữ liệu:   ./csbh cap-nhat

HET
    [ "$cu" = "$moi" ] && echo "  (Bản mới nhất TRÙNG bản đang chạy — lượt này chỉ còn là làm sạch dữ liệu.)" && echo ""
    printf '  Gõ "XOA-SACH" để tiếp tục: '
    read -r xn
    [ "$xn" = "XOA-SACH" ] || { echo "  Đã huỷ."; exit 1; }

    # Sao lưu TRƯỚC mọi bước phá huỷ VÀ trước khi kéo: một lượt hỏng giữa chừng mà
    # không có bản sao lưu ngay trước đó là một lượt không lùi lại được, và ở đây nó
    # còn là thứ duy nhất cứu được một lượt gõ nhầm lệnh. Chưa kéo nên nó chạy bằng
    # ảnh ops CŨ — đúng bản đã ghi dữ liệu.
    echo "==> sao lưu trước khi xoá"
    ops backup

    truoc="$(id_cloudflared)"
    [ -n "$truoc" ] && echo "==> đường hầm đang chạy, sẽ KHÔNG đụng tới"

    echo "==> kéo bản mới nhất từ registry"
    keo_anh_latest
    echo "==> ${cu} -> ${moi}"

    # HẠ SERVICE ỨNG DỤNG TRƯỚC KHI XOÁ, không hạ hạ tầng.
    #
    # `DROP DATABASE` hỏng với "is being accessed by other users" khi còn một
    # kết nối mở, và `reset-db.sh` có ngắt kết nối hộ — nhưng một service còn
    # sống sẽ nối lại ngay, rồi ghi tiếp vào CSDL vừa dựng lại trong lúc
    # migration đang chạy.
    #
    # DANH SÁCH TÍNH BẰNG PHÉP TRỪ, không gõ tay mười cái tên. Thêm một service
    # ứng dụng thứ mười một mà quên sửa danh sách gõ tay thì nó giữ một kết nối,
    # và lượt xoá hỏng ở đúng chỗ khó đọc nhất. Phép trừ thì tự đúng; cái phải
    # giữ đồng bộ chuyển sang danh sách HẠ TẦNG, thứ gần như không đổi.
    #
    # `caddy` ở lại để trang web còn trả lời, `postgres` vì nó là thứ đang bị
    # xoá bên trong, `cloudflared` vì dựng lại nó là đổi địa chỉ công khai.
    GIU_LAI="pg-init postgres redis rabbitmq minio gotenberg mailpit migrate ops caddy cloudflared"
    ha=""
    for sv in $($DC config --services); do
      con=0
      for g in $GIU_LAI; do [ "$sv" = "$g" ] && con=1; done
      [ "$con" = 0 ] && ha="$ha $sv"
    done
    echo "==> dừng service ứng dụng:$ha"
    # shellcheck disable=SC2086
    $DC stop $ha

    echo "==> xoá và dựng lại CSDL"
    $DC run --rm -T -e XAC_NHAN_XOA_SACH=XOA-SACH ops lam-sach

    # DỌN KHO TỆP CÙNG LƯỢT VỚI CSDL.
    #
    # Xoá CSDL mà giữ MinIO thì mọi object còn lại là RÁC — không dòng nào trỏ
    # tới chúng, không màn hình nào hiện chúng, và không có gì dọn chúng; chúng
    # chỉ lớn dần. Bản demo đã hỏng thật vì chuyện này (xem `demo-reset-files`
    # trong Makefile): thư viện minio ném "Entity expansion limit exceeded" từ
    # bên trong luồng, không bắt được, và lượt quét kho chỉ treo tới lúc hết giờ.
    #
    # Mật khẩu đọc TỪ FILE BÍ MẬT, không từ biến môi trường: chồng production
    # đặt `MINIO_ROOT_PASSWORD: ""` có chủ ý (`0108`), nên biến ấy rỗng ở đây.
    echo "==> dọn kho tệp"
    $DC exec -T minio sh -c '
      mk="${MINIO_ROOT_PASSWORD:-}"
      [ -n "$mk" ] || mk="$(cat "${MINIO_ROOT_PASSWORD_FILE:-/run/secrets/minio_password.txt}")"
      mc alias set l http://localhost:9000 "$MINIO_ROOT_USER" "$mk" > /dev/null &&
      mc rm --recursive --force l/csbh/ > /dev/null 2>&1
      mc mb --ignore-existing l/csbh > /dev/null' \
      && echo "  kho tệp đã sạch" || echo "  BỎ QUA kho tệp — dọn tay nếu cần" >&2

    echo "==> migration trên CSDL trống"
    $DC run --rm -T ops migrate

    echo "==> dựng lại"
    $DC up -d --wait

    # ĐO, KHÔNG TIN. `up -d` chỉ dựng lại container có cấu hình đổi, nên
    # `cloudflared` lẽ ra phải nguyên vẹn — nhưng "lẽ ra" là thứ đã làm hỏng
    # những lượt trước đó ở repo này. Id đổi nghĩa là địa chỉ công khai đã đổi,
    # và người vận hành cần biết NGAY thay vì biết khi có người báo liên kết
    # chết.
    sau="$(id_cloudflared)"
    if [ -n "$truoc" ] && [ "$truoc" != "$sau" ]; then
      echo "" >&2
      echo "  CẢNH BÁO: cloudflared ĐÃ bị dựng lại — địa chỉ công khai đổi rồi." >&2
      echo "  Địa chỉ mới:  ./csbh log cloudflared | grep trycloudflare" >&2
      echo "" >&2
    fi

    cat <<HET

  Xong. Phần mềm đã lên bản ${moi} với CSDL TRỐNG.

  Các bước còn lại, theo đúng thứ tự:
    1. ./csbh mo-tai-khoan     tạo tài khoản Quản trị đầu tiên
    2. đăng nhập một lần để đổi mật khẩu lần đầu
    3. ./csbh nap-danh-muc     nạp danh mục mẫu

  Về lại ảnh cũ (dữ liệu vẫn trống):  ./csbh lui-lai
  Lấy lại dữ liệu vừa xoá:             ./csbh phuc-hoi <tệp sao lưu>

HET
    ;;

  sao-luu)      chay_theo_lich SAO_LUU_CSDL 7 0115 "${2:-}" sao_luu_csdl ;;
  dien-tap)     ops restore-drill ;;
  phuc-hoi)
    tep="${2:-}"
    [ -n "$tep" ] || {
      echo "dùng: ./csbh phuc-hoi <tên tệp sao lưu>" >&2
      echo "các bản đang có:" >&2
      $DC run --rm -T --entrypoint sh ops -c 'ls -1t /backup/csbh-*.dump | head -10 | xargs -n1 basename' >&2 || true
      exit 2
    }
    cat <<HET

  CẢNH BÁO — việc này THAY toàn bộ dữ liệu đang chạy bằng nội dung của
  ${tep}. Mọi hồ sơ lập sau thời điểm sao lưu sẽ không còn trong CSDL mới.

  CSDL hiện tại KHÔNG bị xoá: nó được giữ lại dưới tên
  csbh_truoc_phuc_hoi_<giờ>, và lệnh xoá nó in ra ở cuối. Tệp sai hoặc hỏng thì
  lệnh dừng TRƯỚC khi đụng vào gì.

  Muốn kiểm tra bản sao lưu mà không đụng dữ liệu: ./csbh dien-tap

HET
    printf '  Gõ "PHUC-HOI" để tiếp tục: '
    read -r xn
    [ "$xn" = "PHUC-HOI" ] || { echo "  Đã huỷ."; exit 1; }
    $DC run --rm -T -e RESTORE_DB=csbh ops restore "$tep"
    ;;
  sao-luu-tep)  chay_theo_lich SAO_LUU_KHO_TEP 7 0200 "${2:-}" sao_luu_kho_tep ;;
  phuc-hoi-tep)
    # `./csbh phuc-hoi-tep [mốc]` — mặc định bản chụp MỚI NHẤT (`0250`).
    luu="$(doc_env COMPOSE_PROJECT_NAME)_pgbackup"
    ban="${2:-}"
    case "$ban" in
      ''|[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
      *) echo "  Mốc '$ban' sai dạng (vd. 20261105T020000Z)." >&2; exit 2 ;;
    esac
    cat <<HET

  Chép KHO TỆP từ bản chụp ${ban:-mới nhất} trở lại kho đang chạy. Tệp cùng tên bị
  ghi đè bằng bản trong sao lưu; tệp KHÔNG có trong bản chụp thì giữ nguyên — lệnh
  này không xoá gì.

HET
    printf '  Gõ "PHUC-HOI-TEP" để tiếp tục: '
    read -r xn
    [ "$xn" = "PHUC-HOI-TEP" ] || { echo "  Đã huỷ."; exit 1; }
    mc_sh 'ban='"$ban"'
      [ -n "$ban" ] || ban=$(ls -1 /backup/kho-tep 2>/dev/null | grep -E "^[0-9]{8}T[0-9]{6}Z$" | LC_ALL=C sort | tail -1)
      [ -n "$ban" ] && [ -d "/backup/kho-tep/$ban/tep" ] || { echo "  Không có bản chụp ${ban:-nào}." >&2; exit 1; }
      echo "  Phục hồi từ bản chụp $ban"
      for d in /backup/kho-tep/$ban/tep/*/; do
        [ -d "$d" ] || continue
        b=${d%/}; b=${b##*/}
        mc mb --ignore-existing "l/$b" > /dev/null && mc mirror --overwrite --quiet "$d" "l/$b" || exit 1
      done' -v "${luu}:/backup:ro"
    echo "  Xong."
    ;;

  xuat-chuyen-may)
    cat <<'HET'

  XUẤT TOÀN BỘ hệ này để chuyển sang máy khác.

  Hệ sẽ DỪNG từ bây giờ và ĐỂ TẮT sau khi xuất xong: mọi thứ ghi thêm sau mốc
  xuất sẽ không có trên máy mới. Chỉ bật lại máy này (./csbh len) nếu thôi chuyển.

  Ra hai tệp trong ./chuyen-may/<giờ>/:
    chuyen-may-<giờ>.tar   CSDL + kho tệp + nhật ký kiểm toán đã trích + bảng kê
    bi-mat-<giờ>.enc       csbh.env + secrets/, MÃ HOÁ bằng mật khẩu bạn đặt

  Chép CẢ HAI sang máy mới, theo HAI đường khác nhau nếu được. Mất mật khẩu là
  không mở được gói bí mật — và không có nó thì máy mới không mở được CSDL.

HET
    printf '  Gõ "CHUYEN-MAY" để tiếp tục: '
    read -r xn
    [ "$xn" = "CHUYEN-MAY" ] || { echo "  Đã huỷ."; exit 1; }
    hoi_mat_khau '  Mật khẩu cho gói bí mật (tối thiểu 12 ký tự): '; mk1="$MK"
    hoi_mat_khau '  Gõ lại mật khẩu: '; mk2="$MK"
    [ "$mk1" = "$mk2" ] || { echo "  Hai lần gõ không giống nhau." >&2; exit 1; }
    [ "${#mk1}" -ge 12 ] || { echo "  Mật khẩu phải có tối thiểu 12 ký tự." >&2; exit 1; }

    luc="$(date -u +%Y%m%dT%H%M%SZ)"
    ra="$PWD/chuyen-may/$luc"
    mkdir -p "$ra/goi/tep" "$ra/goi/logarchive"

    # 1. CHẶN LỐI VÀO trước, rồi mới xả: còn người dùng bấm thì outbox không bao
    #    giờ về 0. `sla-worker` cũng dừng ở bước này — nó tự ghi (chuyển trạng thái
    #    quá hạn) mà không qua gateway.
    echo "==> chặn lối vào"
    $DC stop caddy gateway sla-worker
    [ -f "$RUN/thu-nghiem" ] && $DC stop cloudflared || true

    # 2. XẢ: mọi sự kiện đã ghi phải tới đích trước khi chụp. Một lá thư nằm trong
    #    outbox lúc xuất sẽ được máy mới gửi lại (đúng); một tin đã rời outbox mà
    #    còn nằm trong hàng đợi RabbitMQ thì MẤT — hàng đợi không đi theo gói. Nên
    #    đợi cả hai về 0, HAI lần liền (một consumer vừa xử xong có thể ghi thêm
    #    một sự kiện mới vào outbox).
    echo "==> chờ xả sự kiện đang trên đường (outbox + hàng đợi)"
    i=0; on=0
    while :; do
      n="$(ops chuyen-may cho-xa | tr -cd '0-9')"
      m="$($DC exec -T rabbitmq rabbitmqctl --silent list_queues messages 2>/dev/null | awk '{s+=$1} END {print s+0}')"
      if [ "${n:-x}" = 0 ] && [ "${m:-x}" = 0 ]; then
        on=$((on + 1)); [ "$on" -ge 2 ] && break
      else
        on=0
      fi
      i=$((i + 1))
      [ "$i" -lt "${CSBH_CHO_XA_LAN:-60}" ] || {
        echo "  Hết giờ chờ: vẫn còn ${n:-?} sự kiện trong outbox, ${m:-?} tin trong hàng đợi." >&2
        echo "  Chưa xuất gì. Hệ đang tắt lối vào — bật lại: ./csbh len" >&2
        exit 1
      }
      sleep "${CSBH_CHO_XA_GIAY:-3}"
    done

    echo "==> dừng các service ứng dụng"
    # `van-hanh` (`0252`) cũng ghi CSDL — lượt nén log hằng đêm ghi `ops.lan_chay`.
    $DC stop identity catalog customer policy document notification audit reporting van-hanh

    echo "==> xuất CSDL"
    $DC run --rm -T --user "$NGUOI" -v "$ra/goi:/xuat" ops chuyen-may xuat-csdl /xuat
    echo "==> xuất kho tệp"
    mc_sh 'mc mirror --quiet l /xuat/tep' --user "$NGUOI" -v "$ra/goi:/xuat"
    la="$CSBH_LOG_ARCHIVE"
    if [ -d "$la" ]; then
      echo "==> nhật ký kiểm toán đã trích: $la"
      cp -a "$la/." "$ra/goi/logarchive/"
    fi
    {
      # Số phiên bản đọc từ ẢNH đang chạy (`0270` — `.env` không còn con số nào).
      echo "PHIEN_BAN=$(phien_ban_may)"
      echo "SITE_URL=$SITE_URL"
      echo "COMPOSE_PROJECT_NAME=$(doc_env COMPOSE_PROJECT_NAME)"
      echo "XUAT_LUC=$luc"
    } > "$ra/goi/thong-tin.txt"
    echo "==> bảng kê"
    $DC run --rm -T --user "$NGUOI" -v "$ra/goi:/xuat" ops chuyen-may ban-ke /xuat
    if [ -s "$ra/goi/khoa-thieu.txt" ]; then
      echo "  CHÚ Ý: máy NÀY đã thiếu $(wc -l < "$ra/goi/khoa-thieu.txt") tệp mà CSDL trỏ tới —" >&2
      echo "  máy mới sẽ thiếu đúng chừng ấy, không hơn. Danh sách trong gói: khoa-thieu.txt" >&2
    fi
    echo "==> đóng gói"
    $DC run --rm -T --user "$NGUOI" -v "$ra:/ra" ops chuyen-may dong-goi /ra/goi "/ra/chuyen-may-$luc.tar"
    rm -rf "$ra/goi"
    echo "==> gói bí mật"
    # Gói bí mật mang `.env` + `secrets/` (định dạng của `0246`, `chuyen-may.sh` không
    # đổi). Từ `0270` hai thứ ấy nằm ở hai chỗ — `/etc/csbh/csbh.env` và
    # `<workspace>/secrets` — nên dựng một thư mục tạm đúng hình dạng cũ rồi gắn nó.
    bm="$WS/tmp/bi-mat-$luc"
    rm -rf "$bm"; ( umask 077; mkdir -p "$bm" ) && cp "$ENV_TEP" "$bm/.env" && cp -a "$WS/secrets" "$bm/secrets"
    CSBH_MAT_KHAU="$mk1" $DC run --rm -T --user "$NGUOI" -e CSBH_MAT_KHAU \
      -v "$bm:/cai:ro" -v "$ra:/ra" ops chuyen-may bi-mat-dong /cai "/ra/bi-mat-$luc.enc"
    rm -rf "$bm"
    cat <<HET

  Xong. Hai tệp ở $ra:
$(ls -1 "$ra" | sed 's/^/    /')

  Máy này ĐANG TẮT phần mềm (CSDL và kho tệp vẫn chạy). Trên máy MỚI:
    1. giải nén bộ cài (bản nào cũng được — lệnh nhập tự kéo đúng bản $(phien_ban_may)) — KHÔNG chạy cai-dat.sh
       (máy mới chưa có Docker thì cài Docker trước)
    2. ./csbh nhap-chuyen-may <gói dữ liệu> <gói bí mật>

  Thôi chuyển thì bật lại máy này: ./csbh len

HET
    ;;
  nhap-chuyen-may)
    goi="${2:-}"; bm="${3:-}"
    { [ -f "$goi" ] && [ -f "$bm" ]; } || {
      echo "dùng: ./csbh nhap-chuyen-may <chuyen-may-….tar> <bi-mat-….enc>" >&2; exit 2; }

    # Chỉ chạy trên một máy CHƯA CÀI. Đã có tệp cấu hình hay volume CSDL nghĩa là máy
    # này đang có một hệ — nhập đè lên nó là mất hệ ấy, và chốt `0113` (bí mật mới +
    # volume cũ) sẽ làm CSDL không mở được. Workspace của máy cũ được kiểm ở dưới,
    # sau khi đọc được nó từ gói.
    [ ! -f "$ENV_TEP" ] || { echo "Đã có $ENV_TEP — máy này đã cài. Không nhập đè." >&2; exit 1; }
    [ -f "$CT/csbh.env.mau" ] || { echo "Không thấy csbh.env.mau cạnh lệnh này — đây không phải thư mục bộ cài." >&2; exit 1; }
    [ -w "$(dirname "$ENV_TEP")" ] || [ -w "$(dirname "$(dirname "$ENV_TEP")")" ] || {
      echo "Cần quyền ghi $(dirname "$ENV_TEP") — chạy bằng sudo." >&2; exit 1; }

    kho="$(grep -E '^CSBH_IMAGE=' "$CT/csbh.env.mau" | cut -d= -f2-)"
    # Ảnh ops nào cũng mở được gói (định dạng gói không đổi theo bản); ĐÚNG bản thì
    # chốt ở dưới, sau khi đọc được gói nói máy cũ chạy bản nào.
    anh="${kho}:ops-latest"
    docker image inspect "$anh" > /dev/null 2>&1 || docker pull "$anh" || {
      echo "Không có ảnh $anh. Đăng nhập registry (docker login) rồi thử lại." >&2; exit 1; }

    goi="$(cd "$(dirname "$goi")" && pwd)/$(basename "$goi")"
    bm="$(cd "$(dirname "$bm")" && pwd)/$(basename "$bm")"
    tam="$(mktemp -d "${TMPDIR:-/tmp}/csbh-nhap.XXXXXX")"
    rm -rf "$tam"; mkdir -p "$tam"

    hoi_mat_khau '  Mật khẩu của gói bí mật: '
    echo "==> mở gói bí mật"
    CSBH_MAT_KHAU="$MK" docker run --rm --user "$NGUOI" -e CSBH_MAT_KHAU \
      -v "$(dirname "$bm"):/vao:ro" -v "$tam:/ra" "$anh" \
      chuyen-may bi-mat-mo "/vao/$(basename "$bm")" /ra/bi-mat || { rm -rf "$tam"; exit 1; }

    du_an="$(grep -E '^COMPOSE_PROJECT_NAME=' "$tam/bi-mat/.env" | cut -d= -f2-)"
    ! docker volume inspect "${du_an}_pgdata" > /dev/null 2>&1 || {
      echo "Máy này đã có CSDL của dự án $du_an (volume ${du_an}_pgdata). Không nhập đè." >&2
      rm -rf "$tam"; exit 1; }

    echo "==> mở gói dữ liệu"
    docker run --rm --user "$NGUOI" -v "$(dirname "$goi"):/vao:ro" -v "$tam:/ra" "$anh" \
      chuyen-may mo-goi "/vao/$(basename "$goi")" /ra/goi || { rm -rf "$tam"; exit 1; }

    # CÙNG PHIÊN BẢN, không "mới hơn cũng được": nhập xong là đối chiếu từng bảng,
    # mà một bản mới hơn có migration chạy lúc dựng — đối chiếu sẽ lệch đúng ở chỗ
    # migration vừa đổi. Cập nhật là việc RIÊNG, sau khi đã chuyển xong.
    #
    # Từ `0270` máy chạy `-latest`, mà `latest` trên registry có thể đã đi trước máy
    # cũ. Nên: kéo THẺ SỐ của đúng bản máy cũ (registry giữ mọi thẻ số) rồi gắn nó
    # thành `-latest` NGAY TRÊN MÁY — compose chạy đúng bản ấy mà `.env` không mang số.
    the="$(grep -E '^PHIEN_BAN=' "$tam/goi/thong-tin.txt" | cut -d= -f2-)"
    [ -n "$the" ] || the="$(grep -E '^CSBH_TAG=' "$tam/goi/thong-tin.txt" | cut -d= -f2-)"   # gói xuất trước 0270
    [ -n "$the" ] || { echo "Gói dữ liệu không nói máy cũ chạy bản nào (thong-tin.txt)." >&2; rm -rf "$tam"; exit 1; }
    if [ "$(nhan_anh "$anh")" != "$the" ]; then
      echo "==> máy cũ chạy bản $the — kéo đúng bản ấy"
      for tp in service web ops; do
        docker pull "${kho}:${tp}-${the}" > /dev/null && docker tag "${kho}:${tp}-${the}" "${kho}:${tp}-latest" || {
          echo "Không kéo được ${kho}:${tp}-${the}. Đăng nhập registry rồi thử lại." >&2; rm -rf "$tam"; exit 1; }
      done
    fi
    docker image inspect "${kho}:minio-latest" > /dev/null 2>&1 || docker pull "${kho}:minio-latest" > /dev/null || {
      echo "Không kéo được ${kho}:minio-latest." >&2; rm -rf "$tam"; exit 1; }

    # Tệp cấu hình của máy cũ → `/etc/csbh/csbh.env`; workspace ĐỌC TỪ chính tệp ấy.
    ws_moi="$(grep -E '^CSBH_WORKSPACE=' "$tam/bi-mat/.env" | tail -1 | cut -d= -f2-)"
    ws_moi="${ws_moi:-/srv/csbh}"
    if [ -e "$ws_moi/secrets" ] || [ -e "$ws_moi/data/postgres" ]; then
      echo "Workspace $ws_moi đã có bí mật hoặc dữ liệu — máy này đã cài. Không nhập đè." >&2
      rm -rf "$tam"; exit 1
    fi
    mkdir -p "$(dirname "$ENV_TEP")"
    ( umask 027; cp "$tam/bi-mat/.env" "$ENV_TEP" )
    # Gói xuất trước `0270` không có `CSBH_WORKSPACE` (và còn `CSBH_TAG`): ghi rõ ra.
    grep -qE '^CSBH_WORKSPACE=' "$ENV_TEP" || printf '\nCSBH_WORKSPACE=%s\n' "$ws_moi" >> "$ENV_TEP"
    sed -i '/^CSBH_TAG=/d' "$ENV_TEP"
    dat_workspace
    mkdir -p "$WS/secrets" "$WS/data/postgres" "$WS/data/redis" "$WS/data/rabbitmq" "$WS/data/minio" \
      "$WS/data/caddy" "$WS/data/caddy-config" "$WS/backup" "$RUN" "$WS/tmp" \
      "$CSBH_LOG_DIR" "$CSBH_LOG_ARCHIVE" "$CSBH_BACKUP_MIRROR"
    chmod 700 "$WS/secrets"
    cp -a "$tam/bi-mat/secrets/." "$WS/secrets/" && chmod 600 "$WS/secrets"/*
    cd "$WS"
    echo "==> dựng hạ tầng"
    $DC up -d --wait postgres minio rabbitmq redis

    echo "==> nạp CSDL"
    $DC run --rm -T --user "$NGUOI" -e RESTORE_DB=csbh -v "$tam/goi:/xuat:ro" ops restore /xuat/csdl.dump
    # Cụm vừa dựng có sẵn một CSDL `csbh` TRỐNG do ảnh Postgres tạo; `restore.sh`
    # giữ nó lại dưới tên `csbh_truoc_phuc_hoi_<giờ>`. Ở đây chắc chắn nó trống
    # (đã từ chối khi có volume CSDL) nên xoá luôn.
    for db in $(ops psql -d postgres -Atc "SELECT datname FROM pg_database WHERE datname LIKE 'csbh_truoc_phuc_hoi_%'"); do
      ops psql -d postgres -qc "DROP DATABASE \"$db\""
    done

    echo "==> nạp kho tệp"
    mc_sh 'for d in /vao/tep/*/; do
      [ -d "$d" ] || continue
      b=${d%/}; b=${b##*/}
      mc mb --ignore-existing "l/$b" > /dev/null && mc mirror --overwrite --quiet "$d" "l/$b" || exit 1
    done' --user "$NGUOI" -v "$tam/goi:/vao:ro"
    la="$CSBH_LOG_ARCHIVE"
    if [ -n "$(ls -A "$tam/goi/logarchive" 2>/dev/null)" ]; then
      echo "==> nhật ký kiểm toán đã trích -> $la"
      mkdir -p "$la" && cp -a "$tam/goi/logarchive/." "$la/"
    fi

    # ĐỐI CHIẾU TRƯỚC KHI BẬT PHẦN MỀM: service vừa lên là có việc ghi (`sla-worker`
    # chuyển trạng thái quá hạn, `document` nạp mẫu mặc định) — so sau đó thì lệch
    # thật lẫn lệch do chính lượt bật sẽ không tách được. Tệp so bằng cách TẢI LẠI
    # từ MinIO của máy mới: câu hỏi là "máy mới phục vụ ra đúng nội dung ấy không",
    # không phải "thư mục tạm có đúng không".
    echo "==> đối chiếu với máy cũ"
    mkdir -p "$tam/kiem/tep"
    mc_sh 'mc mirror --quiet l /kiem/tep' --user "$NGUOI" -v "$tam/kiem:/kiem"
    $DC run --rm -T --user "$NGUOI" -v "$tam:/t" ops chuyen-may ban-ke /t/kiem
    if ! $DC run --rm -T --user "$NGUOI" -v "$tam:/t" ops chuyen-may so-sanh /t/goi /t/kiem; then
      cat >&2 <<HET

  ĐỐI CHIẾU LỆCH — phần mềm CHƯA được bật. CSDL và kho tệp vẫn chạy để tra.
  Dữ liệu đã giải nén để đối chiếu ở $tam.

HET
      exit 1
    fi

    echo "==> migration và bật phần mềm"
    $DC run --rm -T ops migrate
    $DC up -d --wait
    rm -rf "$tam"
    cat <<HET

  Xong. Máy này giờ chạy đúng dữ liệu của máy cũ: $SITE_URL

  Còn lại, theo thứ tự:
    1. Trỏ DNS của tên miền về máy này (nếu đổi máy chủ).
    2. Địa chỉ phần mềm ĐỔI thì sửa SITE_ADDRESS trong $ENV_TEP, sửa redirect URI ở
       Google Console (nếu bật đăng nhập Google).
    3. sudo ./cai-dat.sh — cài lịch tự động, tác tử, và áp lại cấu hình (KHÔNG đụng dữ liệu).
    4. Tắt hẳn máy cũ — đừng để hai máy cùng chạy và cùng gửi thư.

HET
    ;;
  don-du-lieu)  ops retention ;;

  so-tai-khoan)
    # Số tài khoản trong CSDL — `cai-dat.sh` hỏi để biết đây có phải lần cài đầu.
    # In rỗng khi CSDL chưa trả lời: người gọi KHÔNG được hiểu rỗng là "0".
    q_ops "SELECT count(*) FROM idn.app_user" ;;

  tao-quan-tri-dau)
    # Tài khoản Quản trị ĐẦU TIÊN từ `csbh.env` (`0270`) — bản không hỏi của
    # `mo-tai-khoan`, cho `cai-dat.sh`. Bốn chốt của `bootstrap-admin` giữ nguyên (từ
    # chối khi đã có tài khoản, luật mật khẩu, miền thư, bắt đổi mật khẩu lần đầu).
    #
    # Mật khẩu đi qua TỆP trong `secrets/` (container gắn sẵn ở /run/secrets), không
    # qua `-e`: `docker inspect` của container `run` in mọi biến. Tệp xoá ngay sau.
    t="$WS/secrets/admin_mat_khau.txt"
    v="$(doc_env ADMIN_MAT_KHAU)"
    [ -n "$v" ] || { echo "Thiếu ADMIN_MAT_KHAU trong $ENV_TEP." >&2; exit 1; }
    ( umask 077; printf '%s' "$v" > "$t" )
    set +e
    $DC run --rm -T \
      -e ADMIN_USERNAME="$(doc_env ADMIN_TEN_DANG_NHAP)" -e ADMIN_EMAIL="$(doc_env ADMIN_EMAIL)" \
      -e ADMIN_FULL_NAME="$(doc_env ADMIN_HO_TEN)" -e ADMIN_PASSWORD_FILE=/run/secrets/admin_mat_khau.txt \
      ops bootstrap-admin
    ma=$?
    set -e
    rm -f "$t"
    exit $ma ;;

  mo-tai-khoan)
    printf 'Tên đăng nhập: '; read -r u
    printf 'Địa chỉ thư:   '; read -r e
    printf 'Họ tên:        '; read -r n
    # Mật khẩu KHÔNG hiện ra màn hình và KHÔNG vào lịch sử shell.
    stty -echo 2>/dev/null || true
    printf 'Mật khẩu (tối thiểu 10 ký tự, có chữ và số): '; read -r p; echo ""
    stty echo 2>/dev/null || true
    $DC run --rm -T \
      -e ADMIN_USERNAME="$u" -e ADMIN_EMAIL="$e" -e ADMIN_FULL_NAME="$n" \
      -e ADMIN_PASSWORD="$p" ops bootstrap-admin
    ;;

  nap-danh-muc)
    cat <<'HET'

  Nạp DỮ LIỆU MẪU vào danh mục: nhóm sản phẩm, sản phẩm kèm giá, ba quy định
  chiết khấu, và ba văn bản mẫu (A4 dọc · A4 ngang · hợp đồng).

  Đây là SỐ MINH HOẠ, không phải danh mục thật của công ty. Lệnh từ chối chạy
  nếu danh mục đã có sản phẩm.

  Cần một tài khoản Quản trị ĐÃ đổi mật khẩu lần đầu.

HET
    printf 'Tên đăng nhập Quản trị: '; read -r u
    stty -echo 2>/dev/null || true
    printf 'Mật khẩu: '; read -r p; echo ""
    stty echo 2>/dev/null || true
    $DC run --rm -T -e ADMIN_USERNAME="$u" -e ADMIN_PASSWORD="$p" ops nap-danh-muc
    ;;

  thu-thu)
    dia="${2:-}"
    [ -n "$dia" ] || { echo "dùng: ./csbh thu-thu <địa chỉ>" >&2; exit 2; }
    echo "Gửi thư thử tới ${dia} bằng đường ĐẶT LẠI MẬT KHẨU của tài khoản quản trị."
    echo "Không có thư nào tới trong 2 phút thì xem tai-lieu/05-VAN-HANH.md, mục Thư."
    $DC exec -T gateway sh -c \
      "curl -fsS -X POST http://identity:3001/auth/forgot-password \
        -H 'content-type: application/json' -d '{\"username\":\"${dia}\"}' || true"
    ;;

  mo-thu-nghiem)
    cat <<'HET'

  Việc này ĐƯA HỆ THỐNG RA INTERNET. Ai có địa chỉ là tới được màn hình đăng
  nhập — không có lớp chặn nào trước nó ngoài chính màn hình ấy.

  Địa chỉ là NGẪU NHIÊN và ĐỔI MỖI LẦN mở lại, nên liên kết trong những lá thư
  đã gửi sẽ chết. Dùng để xem thử, không dùng để bàn giao.

HET
    printf '  Gõ "MO" để tiếp tục: '
    read -r xn
    [ "$xn" = "MO" ] || { echo "  Đã huỷ."; exit 1; }

    # Cất cấu hình cũ NGUYÊN VĂN để `dong-thu-nghiem` trả lại đúng như trước.
    # Ghi lại bằng cách đọc `.env` chứ không nhớ trong đầu: người mở đường hầm
    # và người đóng nó có thể là hai người, cách nhau vài ngày.
    # `0270`: KHÔNG sửa tệp cấu hình nữa. Địa chỉ tạm ghi ở `run/thu-nghiem`, và
    # `csbh` xuất nó ra môi trường ở mọi lượt chạy (biến môi trường thắng
    # `--env-file`). Đóng đường hầm = xoá tệp ấy — không có gì phải "trả lại".
    #
    # Caddy phải thôi tự xin chứng chỉ: `:80` là địa chỉ KHÔNG có tên miền, nên
    # HTTPS tự động tắt. TLS do biên Cloudflare lo. Xem `docs/04-TRIEN-KHAI.md`.
    echo "SITE_ADDRESS=:80" > "$RUN/thu-nghiem"
    export SITE_ADDRESS=:80

    DC="$DC -f $CT/deploy/compose.tunnel.yml"
    echo "==> dựng lại biên mạng ở cổng 80 và mở đường hầm"
    $DC up -d --force-recreate caddy cloudflared

    echo "==> chờ Cloudflare cấp địa chỉ"
    dia=""
    i=0
    while [ $i -lt 60 ]; do
      dia=$($DC logs --no-color cloudflared 2>/dev/null             | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | tail -1)
      [ -n "$dia" ] && break
      i=$((i + 1)); sleep 2
    done
    [ -n "$dia" ] || {
      echo "  Không thấy địa chỉ sau 2 phút. Xem: ./csbh log cloudflared" >&2
      exit 1
    }

    # SITE_URL là thứ TRÌNH DUYỆT thấy, nên nó là `https://` dù Caddy chạy HTTP.
    # Đặt `http://` ở đây là mọi lời gọi API bị CORS từ chối, trong khi màn hình
    # đăng nhập vẫn hiện ra bình thường — kiểu hỏng khó lần nhất.
    echo "SITE_URL=${dia}" >> "$RUN/thu-nghiem"
    export SITE_URL="$dia"

    echo "==> dựng lại các service đọc địa chỉ ấy"
    $DC up -d --force-recreate gateway identity notification
    cat <<HET

  Địa chỉ công khai: ${dia}

  Đóng lại:  ./csbh dong-thu-nghiem

HET
    ;;

  dong-thu-nghiem)
    [ -f "$RUN/thu-nghiem" ] || { echo "Đường hầm không chạy."; exit 0; }
    echo "==> đóng đường hầm"
    $DC rm -sf cloudflared
    # Xoá tệp dấu là trả về cấu hình trong csbh.env — không có gì phải ghi lại.
    rm -f "$RUN/thu-nghiem"
    unset SITE_ADDRESS SITE_URL
    dat_workspace
    echo "==> dựng lại theo cấu hình cũ"
    $DC up -d --force-recreate caddy gateway identity notification
    echo "  Xong. Đã trả về $SITE_URL"
    ;;

  psql)         shift; $DC run --rm ops psql "$@" ;;
  help|-h|--help) usage ;;
  *) echo "csbh: không có lệnh \"$1\"." >&2; echo "" >&2; usage >&2; exit 2 ;;
esac
